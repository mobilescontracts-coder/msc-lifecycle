[Unit]
Description=SPoS-MSC FastAPI service
After=network.target

[Service]
WorkingDirectory=/opt/spos-msc-prototype
EnvironmentFile=/opt/spos-msc-prototype/.env
ExecStart=/opt/spos-msc-prototype/.venv/bin/uvicorn spos_msc.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
User=ubuntu

[Install]
WantedBy=multi-user.target
