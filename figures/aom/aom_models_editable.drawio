        <mxCell id="trace" value="&lt;b&gt;CPN traceability&lt;/b&gt;&lt;br&gt;R1–R10 → CPN pages/places/transitions/guards/functions → metrics/output matrices → Section 6 evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="1025" width="1080" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;AOM notation legend&lt;/b&gt;&lt;br&gt;Parallelogram = functional goal&lt;br&gt;Cloud = quality goal&lt;br&gt;Actor = role/agent&lt;br&gt;Solid line = decomposition (no arrowheads)&lt;br&gt;Dashed line = contribution/responsibility&lt;br&gt;Gray box = CPN traceability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
