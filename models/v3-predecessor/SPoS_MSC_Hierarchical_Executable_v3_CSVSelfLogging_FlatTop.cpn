  case validators of
      [] =&gt; {runId=0,scenarioId=0,vid=validatorId,owner=validatorId,stake=0,battery=0,cpu=0,
             bandwidth=0,latency=100,availability=0,risk=100,malicious=false,offline=true}
    | (validator:IP_VALIDATOR)::remaining =&gt;
        if #vid validator = validatorId then validator
        else ipFindValidator(remaining,validatorId);
fun ipCountMalicious(validators:IP_VALLIST,members:IP_INTLIST) : int =
  case members of
      [] =&gt; 0
    | validatorId::remaining =&gt;
        (if #malicious(ipFindValidator(validators,validatorId)) then 1 else 0)
        + ipCountMalicious(validators,remaining);
fun ipCommittee(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE,sid:int) : IP_COMMITTEE =
 let val memberIds=ipCommitteeMembers(cfg,sid,#scores g)
 in {runId= #runId cfg,scenarioId= #scenarioId cfg,epoch=1,shardId=sid,members=memberIds,
     proposer=(case memberIds of []=&gt;0 | x::_=&gt;x),quorum= #quorum cfg,recovered=ipRecovered(cfg,sid,#scores g),
     maliciousCount=ipCountMalicious(vl,memberIds)} end;
fun ipCommitteeMS(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE,sid:int) =
 if sid&gt; #nShards cfg then empty else 1`(ipCommittee(cfg,vl,g,sid)) ++ ipCommitteeMS(cfg,vl,g,sid+1);
fun ipGenCommittees(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE)=ipCommitteeMS(cfg,vl,g,1);
fun ipRecoveryMS(cfg:IP_RUNCFG,validators:IP_VALLIST,gov:IP_GOVSTATE,shardId:int) =
