    | x::remaining =&gt;
        if ipMember(x,ys) then ipDistinctAppend(remaining,ys)
        else ipDistinctAppend(remaining,ipAppendOne(ys,x));
fun ipCommitteeMembers(cfg:IP_RUNCFG,sid:int,scores:IP_SCORELIST) =
 let val ranked=ipSortScores(cfg,sid,scores)
     val primary=ipScoreIds(ipFilterVrf(cfg,sid,ranked))
     val filled=ipDistinctAppend(primary,ipScoreIds(ranked))
 in ipTake(#committeeSize cfg,filled) end;
