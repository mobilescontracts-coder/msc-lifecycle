          <layout>colset IP_RUNSUMMARY = record scenarioId:INT * runId:INT * baseSeed:INT * modelTime:INT * stopCode:STRING * counts:IP_COUNTS * latency:IP_LATENCY * metrics:IP_METRICS;</layout>
        </color>
