 let val p = #pending st
 in #terminalTx p = #expectedTx p andalso #evaluatedVal p = #expectedVal p andalso
    #pendingRewards p = 0 andalso #pendingPenalties p = 0 andalso #pendingReconfigs p = 0 andalso
    #committeesBuilt st andalso #committeesBuilt g andalso not(#finalized st)
 end;

