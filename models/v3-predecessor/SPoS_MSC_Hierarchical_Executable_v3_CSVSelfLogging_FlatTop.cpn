  case shards of
      [] =&gt; {sid=shardId,load=100,queue=100,latency=100,capacity=1,processed=0}
    | (shard:IP_SHARDINFO)::remaining =&gt;
        if #sid shard = shardId then shard
        else ipFindShard(remaining,shardId);
fun ipRouteCost(tx:IP_TX,rs:IP_ROUTESTATE,sid:int) =
 let val sh=ipFindShard(#shards rs,sid)
     val home=ipLookupMap(#mapping rs,#contractId tx)
     val target=ipLookupMap(#mapping rs,#targetContract tx)
     val cross=if sid&lt;&gt;home orelse target&lt;&gt;home then 18 else 0
     val mobile=if #connectivity tx=1 then 8 else 0
 in #load sh + #queue sh*3 + #latency sh*2 + cross + mobile end;
fun ipBestShardFrom(tx:IP_TX,rs:IP_ROUTESTATE,sid:int,n:int,best:int,bestCost:int) =
 if sid&gt;n then best else
 let val c=ipRouteCost(tx,rs,sid)
 in if c&lt;bestCost then ipBestShardFrom(tx,rs,sid+1,n,sid,c)
    else ipBestShardFrom(tx,rs,sid+1,n,best,bestCost) end;
fun ipBestShard(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 ipBestShardFrom(tx,rs,2,#nShards cfg,1,ipRouteCost(tx,rs,1));
fun ipTargetShard(tx:IP_TX,rs:IP_ROUTESTATE) = ipLookupMap(#mapping rs,#targetContract tx);
fun ipIsCross(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 let val sid=ipBestShard(cfg,tx,rs) val home=ipLookupMap(#mapping rs,#contractId tx) val tgt=ipTargetShard(tx,rs)
 in sid&lt;&gt;home orelse tgt&lt;&gt;home end;
fun ipRouteDelay(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 1 + (ipRouteCost(tx,rs,ipBestShard(cfg,tx,rs)) div 20) + (if ipIsCross(cfg,tx,rs) then 3 else 0);
fun ipRouteTx(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) : IP_RTX =
 let val sid=ipBestShard(cfg,tx,rs) val d=ipRouteDelay(cfg,tx,rs)
 in {runId= #runId tx,scenarioId= #scenarioId tx,txId= #txId tx,contractId= #contractId tx,
  targetContract= #targetContract tx,userId= #userId tx,amount= #amount tx,battery= #battery tx,cpu= #cpu tx,
  connectivity= #connectivity tx,createdAt= #createdAt tx,preparedAt= #preparedAt tx,routeShard=sid,
  targetShard=ipTargetShard(tx,rs),crossShard=ipIsCross(cfg,tx,rs),routedAt=ipNow()+d} end;
fun ipUpdateShardRoute(shards:IP_SHARDLIST,shardId:int) : IP_SHARDLIST =
  case shards of
      [] =&gt; []
    | (shard:IP_SHARDINFO)::remaining =&gt;
        if #sid shard = shardId then
          {sid= #sid shard,load=ipMin(100,#load shard+8),queue= #queue shard+1,
           latency= #latency shard,capacity= #capacity shard,processed= #processed shard}::remaining
        else shard::ipUpdateShardRoute(remaining,shardId);
fun ipRouteStateAfter(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) : IP_ROUTESTATE =
 {shards=ipUpdateShardRoute(#shards rs,ipBestShard(cfg,tx,rs)),mapping= #mapping rs,version= #version rs};
fun ipHotAfter(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 let val rs2=ipRouteStateAfter(cfg,tx,rs) val sid=ipBestShard(cfg,tx,rs) val sh=ipFindShard(#shards rs2,sid)
 in #load sh &gt; #loadThreshold cfg end;
fun ipReconfigMS(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 if ipHotAfter(cfg,tx,rs) then
  let val sid=ipBestShard(cfg,tx,rs)
  in 1`{runId= #runId tx,scenarioId= #scenarioId tx,txId= #txId tx,hotShard=sid,oldVersion= #version rs,
         newVersion= #version rs+1,reconfigAction=&quot;INCREASE_CAPACITY_AND_REMAP&quot;,atTime=ipNow()} end
 else empty;
fun ipReplaceShard(shards:IP_SHARDLIST,shardId:int) : IP_SHARDLIST =
  case shards of
      [] =&gt; []
    | (shard:IP_SHARDINFO)::remaining =&gt;
        if #sid shard = shardId then
          {sid= #sid shard,load=ipMax(0,#load shard-20),queue= #queue shard,
           latency=ipMax(1,#latency shard-1),capacity= #capacity shard+20,
           processed= #processed shard}::remaining
        else shard::ipReplaceShard(remaining,shardId);
fun ipRemapHot(mapping:IP_MAPLIST,hotShard:int,nShards:int) : IP_MAPLIST =
  case mapping of
      [] =&gt; []
    | (entry:IP_MAPENTRY)::remaining =&gt;
        (if #sid entry = hotShard andalso ipPosMod(#contractId entry,3)=0 then
           {contractId= #contractId entry,sid=1+ipPosMod(hotShard,nShards)}
         else entry)
        :: ipRemapHot(remaining,hotShard,nShards);
fun ipApplyReconfig(cfg:IP_RUNCFG,rs:IP_ROUTESTATE,r:IP_RECONFIG) : IP_ROUTESTATE =
 {shards=ipReplaceShard(#shards rs,#hotShard r),mapping=ipRemapHot(#mapping rs,#hotShard r,#nShards cfg),version= #version rs+1};
fun ipEvidenceRoute(r:IP_RTX,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R2_ROUTING&quot;,code=code,value=value,atTime=ipNow()};
fun ipEvidenceReconfig(r:IP_RECONFIG) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R10_RECONFIG&quot;,code= #reconfigAction r,value= #hotShard r,atTime=ipNow()};</layout>
        </ml>
        <ml id="ID995000644">(* ===== 05_R5_R6_OwnerAwareGovernance ===== *)
(* ---------- R5/R6 owner-aware scoring ---------- *)
fun ipOwnerTotal(validators:IP_VALLIST,ownerId:int) : int =
  case validators of
      [] =&gt; 0
    | (validator:IP_VALIDATOR)::remaining =&gt;
        (if #owner validator = ownerId then #stake validator else 0)
        + ipOwnerTotal(remaining,ownerId);
fun ipOwnerCount(validators:IP_VALLIST,ownerId:int) : int =
  case validators of
      [] =&gt; 0
    | (validator:IP_VALIDATOR)::remaining =&gt;
        (if #owner validator = ownerId then 1 else 0)
        + ipOwnerCount(remaining,ownerId);
fun ipMobileScore(v:IP_VALIDATOR) =
 ipMax(0,(#battery v + #cpu v + #bandwidth v + #availability v) div 4 - (#latency v div 2));
fun ipOwnerPower(v:IP_VALIDATOR,vl:IP_VALLIST) =
 let val total=ipMin(3000,ipOwnerTotal(vl,#owner v)) val members=ipMax(1,ipOwnerCount(vl,#owner v))
 in (ipISqrt(total*100) div members) end;
fun ipFairness(v:IP_VALIDATOR) = 10 + ipPosMod(#vid v*13,11);
fun ipIntegratedScore(v:IP_VALIDATOR,vl:IP_VALLIST) = ipOwnerPower(v,vl)+ipMobileScore(v)- #risk v+ipFairness(v);
fun ipSlashable(v:IP_VALIDATOR) = #malicious v orelse #risk v&gt;=70;
fun ipEligible(v:IP_VALIDATOR,vl:IP_VALLIST) = not(ipSlashable(v)) andalso not(#offline v)
 andalso #stake v&gt;=10 andalso ipMobileScore(v)&gt;=35 andalso ipIntegratedScore(v,vl)&gt;=45;
fun ipBenignExcluded(v:IP_VALIDATOR,vl:IP_VALLIST) = not(ipSlashable(v)) andalso not(ipEligible(v,vl));
fun ipScore(v:IP_VALIDATOR,vl:IP_VALLIST) : IP_SCORE =
 {runId= #runId v,scenarioId= #scenarioId v,vid= #vid v,owner= #owner v,ownerStake=ipOwnerTotal(vl,#owner v),
  ownerPower=ipOwnerPower(v,vl),mobileScore=ipMobileScore(v),riskScore= #risk v,fairness=ipFairness(v),
  score=ipIntegratedScore(v,vl)};
fun ipGovAddScore(g:IP_GOVSTATE,s:IP_SCORE) : IP_GOVSTATE =
 {scores=s:: #scores g,balances= #balances g,quarantined= #quarantined g,slashed= #slashed g,committeesBuilt= #committeesBuilt g};
fun ipGovQuarantine(g:IP_GOVSTATE,vid:int,slash:bool) : IP_GOVSTATE =
 {scores= #scores g,balances= #balances g,quarantined=ipAddUnique(vid,#quarantined g),
  slashed=(if slash then ipAddUnique(vid,#slashed g) else #slashed g),committeesBuilt= #committeesBuilt g};
fun ipSecurityVal(v:IP_VALIDATOR,kind:string,severity:int) : IP_SECURITY =
 {runId= #runId v,scenarioId= #scenarioId v,txId=0,vid= #vid v,kind=kind,severity=severity,atTime=ipNow()};
fun ipPenaltyVal(v:IP_VALIDATOR) : IP_PENALTYTASK =
 {runId= #runId v,scenarioId= #scenarioId v,txId=0,vid= #vid v,kind=&quot;RISK_QUARANTINE&quot;,amount=25,slashable=true};
fun ipEvidenceVal(v:IP_VALIDATOR,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId v,scenarioId= #scenarioId v,txId=0,category=&quot;R5_R6_VALIDATOR&quot;,code=code,value=value,atTime=ipNow()};
          <layout>(* ===== 05_R5_R6_OwnerAwareGovernance ===== *)
(* ---------- R5/R6 owner-aware scoring ---------- *)
fun ipOwnerTotal(validators:IP_VALLIST,ownerId:int) : int =
  case validators of
      [] =&gt; 0
    | (validator:IP_VALIDATOR)::remaining =&gt;
        (if #owner validator = ownerId then #stake validator else 0)
        + ipOwnerTotal(remaining,ownerId);
fun ipOwnerCount(validators:IP_VALLIST,ownerId:int) : int =
  case validators of
      [] =&gt; 0
    | (validator:IP_VALIDATOR)::remaining =&gt;
        (if #owner validator = ownerId then 1 else 0)
        + ipOwnerCount(remaining,ownerId);
fun ipMobileScore(v:IP_VALIDATOR) =
 ipMax(0,(#battery v + #cpu v + #bandwidth v + #availability v) div 4 - (#latency v div 2));
fun ipOwnerPower(v:IP_VALIDATOR,vl:IP_VALLIST) =
 let val total=ipMin(3000,ipOwnerTotal(vl,#owner v)) val members=ipMax(1,ipOwnerCount(vl,#owner v))
 in (ipISqrt(total*100) div members) end;
fun ipFairness(v:IP_VALIDATOR) = 10 + ipPosMod(#vid v*13,11);
fun ipIntegratedScore(v:IP_VALIDATOR,vl:IP_VALLIST) = ipOwnerPower(v,vl)+ipMobileScore(v)- #risk v+ipFairness(v);
fun ipSlashable(v:IP_VALIDATOR) = #malicious v orelse #risk v&gt;=70;
fun ipEligible(v:IP_VALIDATOR,vl:IP_VALLIST) = not(ipSlashable(v)) andalso not(#offline v)
 andalso #stake v&gt;=10 andalso ipMobileScore(v)&gt;=35 andalso ipIntegratedScore(v,vl)&gt;=45;
fun ipBenignExcluded(v:IP_VALIDATOR,vl:IP_VALLIST) = not(ipSlashable(v)) andalso not(ipEligible(v,vl));
fun ipScore(v:IP_VALIDATOR,vl:IP_VALLIST) : IP_SCORE =
 {runId= #runId v,scenarioId= #scenarioId v,vid= #vid v,owner= #owner v,ownerStake=ipOwnerTotal(vl,#owner v),
  ownerPower=ipOwnerPower(v,vl),mobileScore=ipMobileScore(v),riskScore= #risk v,fairness=ipFairness(v),
  score=ipIntegratedScore(v,vl)};
fun ipGovAddScore(g:IP_GOVSTATE,s:IP_SCORE) : IP_GOVSTATE =
 {scores=s:: #scores g,balances= #balances g,quarantined= #quarantined g,slashed= #slashed g,committeesBuilt= #committeesBuilt g};
fun ipGovQuarantine(g:IP_GOVSTATE,vid:int,slash:bool) : IP_GOVSTATE =
 {scores= #scores g,balances= #balances g,quarantined=ipAddUnique(vid,#quarantined g),
  slashed=(if slash then ipAddUnique(vid,#slashed g) else #slashed g),committeesBuilt= #committeesBuilt g};
fun ipSecurityVal(v:IP_VALIDATOR,kind:string,severity:int) : IP_SECURITY =
 {runId= #runId v,scenarioId= #scenarioId v,txId=0,vid= #vid v,kind=kind,severity=severity,atTime=ipNow()};
fun ipPenaltyVal(v:IP_VALIDATOR) : IP_PENALTYTASK =
 {runId= #runId v,scenarioId= #scenarioId v,txId=0,vid= #vid v,kind=&quot;RISK_QUARANTINE&quot;,amount=25,slashable=true};
fun ipEvidenceVal(v:IP_VALIDATOR,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId v,scenarioId= #scenarioId v,txId=0,category=&quot;R5_R6_VALIDATOR&quot;,code=code,value=value,atTime=ipNow()};</layout>
