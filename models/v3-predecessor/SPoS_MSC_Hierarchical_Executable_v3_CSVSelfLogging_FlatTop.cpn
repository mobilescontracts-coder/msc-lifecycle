fun ipScoreVid(s:IP_SCORE) : int = #vid s;
fun ipVRF(cfg:IP_RUNCFG,sid:int,s:IP_SCORE) = ipPosMod(ipHash4(#baseSeed cfg+ #runId cfg,sid,#vid s,#score s),10000);
fun ipInsertScore(cfg:IP_RUNCFG,sid:int,s:IP_SCORE,scores:IP_SCORELIST) : IP_SCORELIST =
  case scores of [] =&gt; [s] | x::xs =&gt; if ipVRF(cfg,sid,s)&lt;ipVRF(cfg,sid,x) then s::x::xs else x::ipInsertScore(cfg,sid,s,xs);
fun ipSortScores(cfg:IP_RUNCFG,sid:int,scores:IP_SCORELIST) : IP_SCORELIST =
  case scores of [] =&gt; [] | s::ss =&gt; ipInsertScore(cfg,sid,s,ipSortScores(cfg,sid,ss));
