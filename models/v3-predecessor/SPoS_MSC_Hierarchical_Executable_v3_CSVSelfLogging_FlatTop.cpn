    end;
fun ipCountActive(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE,sid:int) =
 if sid&gt; #nShards cfg then 0 else (if ipLength(#members(ipCommittee(cfg,vl,g,sid)))&gt;0 then 1 else 0)+ipCountActive(cfg,vl,g,sid+1);
fun ipCountRecoveries(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE,sid:int) =
 if sid&gt; #nShards cfg then 0 else (if #recovered(ipCommittee(cfg,vl,g,sid)) then 1 else 0)+ipCountRecoveries(cfg,vl,g,sid+1);
fun ipGovCommitteesBuilt(g:IP_GOVSTATE) : IP_GOVSTATE =
 {scores= #scores g,balances= #balances g,quarantined= #quarantined g,slashed= #slashed g,committeesBuilt=true};
