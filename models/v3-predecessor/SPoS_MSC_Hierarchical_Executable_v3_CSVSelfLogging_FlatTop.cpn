        <ml id="ID995000645">(* ===== 06_R7_CommitteeFormation_Recovery ===== *)
(* ---------- R7 committee formation with VRF-style selection/recovery ---------- *)
fun ipScoreVid(s:IP_SCORE) : int = #vid s;
fun ipVRF(cfg:IP_RUNCFG,sid:int,s:IP_SCORE) = ipPosMod(ipHash4(#baseSeed cfg+ #runId cfg,sid,#vid s,#score s),10000);
fun ipInsertScore(cfg:IP_RUNCFG,sid:int,s:IP_SCORE,scores:IP_SCORELIST) : IP_SCORELIST =
  case scores of [] =&gt; [s] | x::xs =&gt; if ipVRF(cfg,sid,s)&lt;ipVRF(cfg,sid,x) then s::x::xs else x::ipInsertScore(cfg,sid,s,xs);
fun ipSortScores(cfg:IP_RUNCFG,sid:int,scores:IP_SCORELIST) : IP_SCORELIST =
  case scores of [] =&gt; [] | s::ss =&gt; ipInsertScore(cfg,sid,s,ipSortScores(cfg,sid,ss));
fun ipVrfSelected(cfg:IP_RUNCFG,sid:int,s:IP_SCORE) = ipVRF(cfg,sid,s)&lt;(2500+ipMin(5000,#score s*20));
fun ipFilterVrf(cfg:IP_RUNCFG,sid:int,scores:IP_SCORELIST) : IP_SCORELIST =
  case scores of [] =&gt; [] | s::ss =&gt; if ipVrfSelected(cfg,sid,s) then s::ipFilterVrf(cfg,sid,ss) else ipFilterVrf(cfg,sid,ss);
fun ipScoreIds(scores:IP_SCORELIST) : IP_INTLIST =
  case scores of
      [] =&gt; []
    | (scoreToken:IP_SCORE)::remaining =&gt; #vid scoreToken :: ipScoreIds(remaining);
fun ipAppendOne(values:IP_INTLIST,x:int) : IP_INTLIST =
  case values of
      [] =&gt; [x]
    | y::remaining =&gt; y::ipAppendOne(remaining,x);
fun ipDistinctAppend(xs:IP_INTLIST,ys:IP_INTLIST) : IP_INTLIST =
  case xs of
      [] =&gt; ys
    | x::remaining =&gt;
        if ipMember(x,ys) then ipDistinctAppend(remaining,ys)
        else ipDistinctAppend(remaining,ipAppendOne(ys,x));
fun ipCommitteeMembers(cfg:IP_RUNCFG,sid:int,scores:IP_SCORELIST) =
 let val ranked=ipSortScores(cfg,sid,scores)
     val primary=ipScoreIds(ipFilterVrf(cfg,sid,ranked))
     val filled=ipDistinctAppend(primary,ipScoreIds(ranked))
 in ipTake(#committeeSize cfg,filled) end;
fun ipRecovered(cfg:IP_RUNCFG,sid:int,scores:IP_SCORELIST) =
 ipLength(ipTake(#committeeSize cfg,ipScoreIds(ipFilterVrf(cfg,sid,ipSortScores(cfg,sid,scores))))) &lt; #committeeSize cfg;
fun ipFindValidator(validators:IP_VALLIST,validatorId:int) : IP_VALIDATOR =
  case validators of
      [] =&gt; {runId=0,scenarioId=0,vid=validatorId,owner=validatorId,stake=0,battery=0,cpu=0,
             bandwidth=0,latency=100,availability=0,risk=100,malicious=false,offline=true}
    | (validator:IP_VALIDATOR)::remaining =&gt;
        if #vid validator = validatorId then validator
        else ipFindValidator(remaining,validatorId);
fun ipCountMalicious(validators:IP_VALLIST,members:IP_INTLIST) : int =
  case members of
      [] =&gt; 0
    | validatorId::remaining =&gt;
        (if #malicious(ipFindValidator(validators,validatorId)) then 1 else 0)
        + ipCountMalicious(validators,remaining);
fun ipCommittee(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE,sid:int) : IP_COMMITTEE =
 let val memberIds=ipCommitteeMembers(cfg,sid,#scores g)
 in {runId= #runId cfg,scenarioId= #scenarioId cfg,epoch=1,shardId=sid,members=memberIds,
     proposer=(case memberIds of []=&gt;0 | x::_=&gt;x),quorum= #quorum cfg,recovered=ipRecovered(cfg,sid,#scores g),
     maliciousCount=ipCountMalicious(vl,memberIds)} end;
fun ipCommitteeMS(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE,sid:int) =
 if sid&gt; #nShards cfg then empty else 1`(ipCommittee(cfg,vl,g,sid)) ++ ipCommitteeMS(cfg,vl,g,sid+1);
fun ipGenCommittees(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE)=ipCommitteeMS(cfg,vl,g,1);
fun ipRecoveryMS(cfg:IP_RUNCFG,validators:IP_VALLIST,gov:IP_GOVSTATE,shardId:int) =
  if shardId &gt; #nShards cfg then empty
  else
    let
      val committeeValue = ipCommittee(cfg,validators,gov,shardId)
      val beforeSizeValue =
        ipLength(ipScoreIds(ipFilterVrf(cfg,shardId,ipSortScores(cfg,shardId,#scores gov))))
    in
      (if #recovered committeeValue then
         1`{runId= #runId cfg,scenarioId= #scenarioId cfg,shardId=shardId,
            beforeSize=beforeSizeValue,afterSize=ipLength(#members committeeValue),atTime=ipNow()}
       else empty)
      ++ ipRecoveryMS(cfg,validators,gov,shardId+1)
    end;
fun ipCountActive(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE,sid:int) =
 if sid&gt; #nShards cfg then 0 else (if ipLength(#members(ipCommittee(cfg,vl,g,sid)))&gt;0 then 1 else 0)+ipCountActive(cfg,vl,g,sid+1);
fun ipCountRecoveries(cfg:IP_RUNCFG,vl:IP_VALLIST,g:IP_GOVSTATE,sid:int) =
 if sid&gt; #nShards cfg then 0 else (if #recovered(ipCommittee(cfg,vl,g,sid)) then 1 else 0)+ipCountRecoveries(cfg,vl,g,sid+1);
fun ipGovCommitteesBuilt(g:IP_GOVSTATE) : IP_GOVSTATE =
 {scores= #scores g,balances= #balances g,quarantined= #quarantined g,slashed= #slashed g,committeesBuilt=true};
fun ipEvidenceCommittee(cfg:IP_RUNCFG,active:int,recovered:int) =
 1`{runId= #runId cfg,scenarioId= #scenarioId cfg,txId=0,category=&quot;R7_COMMITTEE&quot;,code=&quot;COMMITTEES_BUILT&quot;,
    value=active*100+recovered,atTime=ipNow()};
