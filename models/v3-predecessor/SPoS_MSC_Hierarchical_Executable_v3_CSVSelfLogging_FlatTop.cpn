        <ml id="ID995000649">(* ===== 10_R8_Incentives_Feedback ===== *)
(* ---------- R8 rewards/slashing and next-epoch balance feedback ---------- *)
fun ipUpdateReward(balances:IP_BALANCELIST,validatorId:int,amount:int) : IP_BALANCELIST =
  case balances of
      [] =&gt; []
    | (balance:IP_BALANCE)::remaining =&gt;
        if #vid balance = validatorId then
          {vid= #vid balance,owner= #owner balance,stake= #stake balance+amount,
           reward= #reward balance+amount,penalty= #penalty balance}::remaining
        else balance::ipUpdateReward(remaining,validatorId,amount);
fun ipUpdatePenalty(balances:IP_BALANCELIST,validatorId:int,amount:int) : IP_BALANCELIST =
  case balances of
      [] =&gt; []
    | (balance:IP_BALANCE)::remaining =&gt;
        if #vid balance = validatorId then
          {vid= #vid balance,owner= #owner balance,stake=ipMax(0,#stake balance-amount),
           reward= #reward balance,penalty= #penalty balance+amount}::remaining
        else balance::ipUpdatePenalty(remaining,validatorId,amount);
fun ipGovReward(g:IP_GOVSTATE,t:IP_REWARDTASK) : IP_GOVSTATE =
 {scores= #scores g,balances=ipUpdateReward(#balances g,#vid t,#amount t),quarantined= #quarantined g,
  slashed= #slashed g,committeesBuilt= #committeesBuilt g};
fun ipGovPenalty(g:IP_GOVSTATE,t:IP_PENALTYTASK) : IP_GOVSTATE =
 {scores= #scores g,balances=ipUpdatePenalty(#balances g,#vid t,#amount t),
  quarantined=(if #slashable t then ipAddUnique(#vid t,#quarantined g) else #quarantined g),
  slashed=(if #slashable t then ipAddUnique(#vid t,#slashed g) else #slashed g),committeesBuilt= #committeesBuilt g};
fun ipFindBalance(balances:IP_BALANCELIST,validatorId:int) : IP_BALANCE =
  case balances of
      [] =&gt; {vid=validatorId,owner=validatorId,stake=0,reward=0,penalty=0}
    | (balance:IP_BALANCE)::remaining =&gt;
        if #vid balance = validatorId then balance
        else ipFindBalance(remaining,validatorId);
fun ipRewardEvent(g:IP_GOVSTATE,t:IP_REWARDTASK) : IP_REWARDEVENT =
 let val b=ipFindBalance(#balances (ipGovReward(g,t)),#vid t)
 in {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,vid= #vid t,role= #role t,amount= #amount t,
     newStake= #stake b,atTime=ipNow()} end;
fun ipPenaltyEvent(g:IP_GOVSTATE,t:IP_PENALTYTASK) : IP_PENALTYEVENT =
 let val b=ipFindBalance(#balances (ipGovPenalty(g,t)),#vid t)
 in {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,vid= #vid t,kind= #kind t,amount= #amount t,
     newStake= #stake b,slashable= #slashable t,atTime=ipNow()} end;
fun ipEvidenceReward(t:IP_REWARDTASK) : IP_EVIDENCE =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,category=&quot;R8_INCENTIVE&quot;,code= #role t,value= #amount t,atTime=ipNow()};
fun ipEvidencePenalty(t:IP_PENALTYTASK) : IP_EVIDENCE =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,category=&quot;R8_PENALTY&quot;,code= #kind t,value= #amount t,atTime=ipNow()};
          <layout>(* ===== 10_R8_Incentives_Feedback ===== *)
(* ---------- R8 rewards/slashing and next-epoch balance feedback ---------- *)
fun ipUpdateReward(balances:IP_BALANCELIST,validatorId:int,amount:int) : IP_BALANCELIST =
  case balances of
      [] =&gt; []
    | (balance:IP_BALANCE)::remaining =&gt;
        if #vid balance = validatorId then
          {vid= #vid balance,owner= #owner balance,stake= #stake balance+amount,
           reward= #reward balance+amount,penalty= #penalty balance}::remaining
        else balance::ipUpdateReward(remaining,validatorId,amount);
fun ipUpdatePenalty(balances:IP_BALANCELIST,validatorId:int,amount:int) : IP_BALANCELIST =
  case balances of
      [] =&gt; []
    | (balance:IP_BALANCE)::remaining =&gt;
        if #vid balance = validatorId then
          {vid= #vid balance,owner= #owner balance,stake=ipMax(0,#stake balance-amount),
           reward= #reward balance,penalty= #penalty balance+amount}::remaining
        else balance::ipUpdatePenalty(remaining,validatorId,amount);
fun ipGovReward(g:IP_GOVSTATE,t:IP_REWARDTASK) : IP_GOVSTATE =
 {scores= #scores g,balances=ipUpdateReward(#balances g,#vid t,#amount t),quarantined= #quarantined g,
  slashed= #slashed g,committeesBuilt= #committeesBuilt g};
fun ipGovPenalty(g:IP_GOVSTATE,t:IP_PENALTYTASK) : IP_GOVSTATE =
 {scores= #scores g,balances=ipUpdatePenalty(#balances g,#vid t,#amount t),
  quarantined=(if #slashable t then ipAddUnique(#vid t,#quarantined g) else #quarantined g),
  slashed=(if #slashable t then ipAddUnique(#vid t,#slashed g) else #slashed g),committeesBuilt= #committeesBuilt g};
fun ipFindBalance(balances:IP_BALANCELIST,validatorId:int) : IP_BALANCE =
  case balances of
      [] =&gt; {vid=validatorId,owner=validatorId,stake=0,reward=0,penalty=0}
    | (balance:IP_BALANCE)::remaining =&gt;
        if #vid balance = validatorId then balance
        else ipFindBalance(remaining,validatorId);
fun ipRewardEvent(g:IP_GOVSTATE,t:IP_REWARDTASK) : IP_REWARDEVENT =
 let val b=ipFindBalance(#balances (ipGovReward(g,t)),#vid t)
 in {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,vid= #vid t,role= #role t,amount= #amount t,
     newStake= #stake b,atTime=ipNow()} end;
fun ipPenaltyEvent(g:IP_GOVSTATE,t:IP_PENALTYTASK) : IP_PENALTYEVENT =
 let val b=ipFindBalance(#balances (ipGovPenalty(g,t)),#vid t)
 in {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,vid= #vid t,kind= #kind t,amount= #amount t,
     newStake= #stake b,slashable= #slashable t,atTime=ipNow()} end;
fun ipEvidenceReward(t:IP_REWARDTASK) : IP_EVIDENCE =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,category=&quot;R8_INCENTIVE&quot;,code= #role t,value= #amount t,atTime=ipNow()};
fun ipEvidencePenalty(t:IP_PENALTYTASK) : IP_EVIDENCE =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,category=&quot;R8_PENALTY&quot;,code= #kind t,value= #amount t,atTime=ipNow()};</layout>
        </ml>
        <ml id="ID995000650">(* ===== 11_R9_DecentralisationMetrics ===== *)
(* ---------- R9 decentralisation metrics ---------- *)
fun ipRewards(balances:IP_BALANCELIST) : IP_INTLIST =
  case balances of
      [] =&gt; []
    | (balance:IP_BALANCE)::remaining =&gt; #reward balance :: ipRewards(remaining);
fun ipNonNegative(values:IP_INTLIST) : IP_INTLIST =
  case values of [] =&gt; [] | x::remaining =&gt; if x&gt;=0 then x::ipNonNegative(remaining) else ipNonNegative(remaining);
fun ipPositive(values:IP_INTLIST) : IP_INTLIST =
  case values of [] =&gt; [] | x::remaining =&gt; if x&gt;0 then x::ipPositive(remaining) else ipPositive(remaining);
fun ipAbsAgainst(x:int,values:IP_INTLIST) : int =
  case values of [] =&gt; 0 | y::remaining =&gt; ipAbs(x-y)+ipAbsAgainst(x,remaining);
fun ipAllAbs(values:IP_INTLIST,allValues:IP_INTLIST) : int =
  case values of [] =&gt; 0 | x::remaining =&gt; ipAbsAgainst(x,allValues)+ipAllAbs(remaining,allValues);
fun ipGiniBP(vals:IP_INTLIST) =
 let val xs=ipNonNegative(vals) val n=ipLength(xs) val total=ipSumInt(xs)
 in if n=0 orelse total=0 then 0 else (10000*ipAllAbs(xs,xs)) div (2*n*total) end;
fun ipShareSquareBP (values:IP_INTLIST,total:int) : int =
  case values of
      [] =&gt; 0
    | x::remaining =&gt;
        let val shareBP = (10000*x) div total
        in ((shareBP*shareBP) div 10000) + ipShareSquareBP(remaining,total) end;
fun ipHHIBP (vals:IP_INTLIST) : int =
  let val xs=ipNonNegative(vals)
      val total=ipSumInt(xs)
  in if total=0 then 0 else ipShareSquareBP(xs,total) end;
val IP_NAKAMOTO_THRESHOLD_PERCENT = 51;
fun ipInsertDesc(x:int,values:IP_INTLIST) : IP_INTLIST =
  case values of [] =&gt; [x] | y::remaining =&gt; if x&gt;=y then x::y::remaining else y::ipInsertDesc(x,remaining);
fun ipSortDesc(values:IP_INTLIST) : IP_INTLIST =
  case values of [] =&gt; [] | x::remaining =&gt; ipInsertDesc(x,ipSortDesc(remaining));
fun ipNakamotoLoop(values:IP_INTLIST,total:int,acc:int,k:int) : int =
  case values of
      [] =&gt; k
    | x::remaining =&gt;
        if (acc+x)*100 &gt;= IP_NAKAMOTO_THRESHOLD_PERCENT*total then k+1
        else ipNakamotoLoop(remaining,total,acc+x,k+1);
fun ipNakamoto(vals:IP_INTLIST) = let val xs=ipSortDesc(ipPositive(vals)) val total=ipSumInt(xs)
 in if total=0 then 0 else ipNakamotoLoop(xs,total,0,0) end;
fun ipOwners(balances:IP_BALANCELIST) : IP_INTLIST =
  case balances of
      [] =&gt; []
    | (balance:IP_BALANCE)::remaining =&gt; ipAddUnique(#owner balance,ipOwners(remaining));
fun ipOwnerReward(balances:IP_BALANCELIST,ownerId:int) : int =
  case balances of
      [] =&gt; 0
    | (balance:IP_BALANCE)::remaining =&gt;
        (if #owner balance = ownerId then #reward balance else 0)
        + ipOwnerReward(remaining,ownerId);
fun ipMaxOwner(ownerIds:IP_INTLIST,balances:IP_BALANCELIST) : int =
  case ownerIds of
      [] =&gt; 0
    | ownerId::remainingOwners =&gt;
        ipMax(ipOwnerReward(balances,ownerId),ipMaxOwner(remainingOwners,balances));
fun ipOwnerConcentrationBP(bs:IP_BALANCELIST) = let val total=ipSumInt(ipRewards(bs))
 in if total=0 then 0 else (10000*ipMaxOwner(ipOwners(bs),bs)) div total end;
fun ipLoads(shards:IP_SHARDLIST) : IP_INTLIST =
  case shards of [] =&gt; [] | (shard:IP_SHARDINFO)::remaining =&gt; #load shard :: ipLoads(remaining);
fun ipVariance(values:IP_INTLIST,meanValue:int) : int =
  case values of [] =&gt; 0 | x::remaining =&gt; (x-meanValue)*(x-meanValue)+ipVariance(remaining,meanValue);
fun ipLoadStdBP(rs:IP_ROUTESTATE) = let val xs=ipLoads(#shards rs) val n=ipMax(1,ipLength(xs)) val mean=ipSumInt(xs) div n
 in 100*ipISqrt(ipVariance(xs,mean) div n) end;
          <layout>(* ===== 11_R9_DecentralisationMetrics ===== *)
(* ---------- R9 decentralisation metrics ---------- *)
fun ipRewards(balances:IP_BALANCELIST) : IP_INTLIST =
  case balances of
      [] =&gt; []
    | (balance:IP_BALANCE)::remaining =&gt; #reward balance :: ipRewards(remaining);
fun ipNonNegative(values:IP_INTLIST) : IP_INTLIST =
  case values of [] =&gt; [] | x::remaining =&gt; if x&gt;=0 then x::ipNonNegative(remaining) else ipNonNegative(remaining);
fun ipPositive(values:IP_INTLIST) : IP_INTLIST =
  case values of [] =&gt; [] | x::remaining =&gt; if x&gt;0 then x::ipPositive(remaining) else ipPositive(remaining);
fun ipAbsAgainst(x:int,values:IP_INTLIST) : int =
  case values of [] =&gt; 0 | y::remaining =&gt; ipAbs(x-y)+ipAbsAgainst(x,remaining);
fun ipAllAbs(values:IP_INTLIST,allValues:IP_INTLIST) : int =
  case values of [] =&gt; 0 | x::remaining =&gt; ipAbsAgainst(x,allValues)+ipAllAbs(remaining,allValues);
fun ipGiniBP(vals:IP_INTLIST) =
 let val xs=ipNonNegative(vals) val n=ipLength(xs) val total=ipSumInt(xs)
 in if n=0 orelse total=0 then 0 else (10000*ipAllAbs(xs,xs)) div (2*n*total) end;
fun ipShareSquareBP (values:IP_INTLIST,total:int) : int =
  case values of
      [] =&gt; 0
    | x::remaining =&gt;
        let val shareBP = (10000*x) div total
        in ((shareBP*shareBP) div 10000) + ipShareSquareBP(remaining,total) end;
fun ipHHIBP (vals:IP_INTLIST) : int =
  let val xs=ipNonNegative(vals)
      val total=ipSumInt(xs)
  in if total=0 then 0 else ipShareSquareBP(xs,total) end;
val IP_NAKAMOTO_THRESHOLD_PERCENT = 51;
fun ipInsertDesc(x:int,values:IP_INTLIST) : IP_INTLIST =
  case values of [] =&gt; [x] | y::remaining =&gt; if x&gt;=y then x::y::remaining else y::ipInsertDesc(x,remaining);
fun ipSortDesc(values:IP_INTLIST) : IP_INTLIST =
  case values of [] =&gt; [] | x::remaining =&gt; ipInsertDesc(x,ipSortDesc(remaining));
fun ipNakamotoLoop(values:IP_INTLIST,total:int,acc:int,k:int) : int =
  case values of
      [] =&gt; k
    | x::remaining =&gt;
        if (acc+x)*100 &gt;= IP_NAKAMOTO_THRESHOLD_PERCENT*total then k+1
        else ipNakamotoLoop(remaining,total,acc+x,k+1);
fun ipNakamoto(vals:IP_INTLIST) = let val xs=ipSortDesc(ipPositive(vals)) val total=ipSumInt(xs)
 in if total=0 then 0 else ipNakamotoLoop(xs,total,0,0) end;
fun ipOwners(balances:IP_BALANCELIST) : IP_INTLIST =
  case balances of
      [] =&gt; []
    | (balance:IP_BALANCE)::remaining =&gt; ipAddUnique(#owner balance,ipOwners(remaining));
fun ipOwnerReward(balances:IP_BALANCELIST,ownerId:int) : int =
  case balances of
      [] =&gt; 0
    | (balance:IP_BALANCE)::remaining =&gt;
        (if #owner balance = ownerId then #reward balance else 0)
        + ipOwnerReward(remaining,ownerId);
fun ipMaxOwner(ownerIds:IP_INTLIST,balances:IP_BALANCELIST) : int =
  case ownerIds of
      [] =&gt; 0
    | ownerId::remainingOwners =&gt;
        ipMax(ipOwnerReward(balances,ownerId),ipMaxOwner(remainingOwners,balances));
fun ipOwnerConcentrationBP(bs:IP_BALANCELIST) = let val total=ipSumInt(ipRewards(bs))
 in if total=0 then 0 else (10000*ipMaxOwner(ipOwners(bs),bs)) div total end;
fun ipLoads(shards:IP_SHARDLIST) : IP_INTLIST =
  case shards of [] =&gt; [] | (shard:IP_SHARDINFO)::remaining =&gt; #load shard :: ipLoads(remaining);
fun ipVariance(values:IP_INTLIST,meanValue:int) : int =
  case values of [] =&gt; 0 | x::remaining =&gt; (x-meanValue)*(x-meanValue)+ipVariance(remaining,meanValue);
fun ipLoadStdBP(rs:IP_ROUTESTATE) = let val xs=ipLoads(#shards rs) val n=ipMax(1,ipLength(xs)) val mean=ipSumInt(xs) div n
 in 100*ipISqrt(ipVariance(xs,mean) div n) end;</layout>
        </ml>
        <ml id="ID995000651">(* ===== 12_R10_Finalisation_CSV ===== *)
(* ---------- R10 finalisation, invariant-aware summary and CSV helpers ---------- *)
fun ipCanFinalize(st:IP_RUNSTATE,g:IP_GOVSTATE) =
 let val p = #pending st
 in #terminalTx p = #expectedTx p andalso #evaluatedVal p = #expectedVal p andalso
    #pendingRewards p = 0 andalso #pendingPenalties p = 0 andalso #pendingReconfigs p = 0 andalso
    #committeesBuilt st andalso #committeesBuilt g andalso not(#finalized st)
 end;

fun ipLifecycleInvariant(st:IP_RUNSTATE) =
 let val c = #counts st
 in #receipts c &lt;= #rootCommits c andalso #rootCommits c &lt;= #finalityCerts c andalso
    #finalityCerts c &lt;= #shardBlocks c andalso #shardBlocks c &lt;= #routedTx c andalso
    #routedTx c &lt;= #submittedTx c
 end;

fun ipRunMetrics(g:IP_GOVSTATE,rs:IP_ROUTESTATE) : IP_METRICS =
 let val rewards = ipRewards(#balances g)
 in {rewardGiniBP=ipGiniBP(rewards),
     rewardHHIBP=ipHHIBP(rewards),
     nakamotoCoefficient=ipNakamoto(rewards),
     ownerConcentrationBP=ipOwnerConcentrationBP(#balances g),
     shardLoadStdBP=ipLoadStdBP(rs)}
 end;

fun ipRunSummary(cfg:IP_RUNCFG,st:IP_RUNSTATE,g:IP_GOVSTATE,rs:IP_ROUTESTATE) : IP_RUNSUMMARY =
 let val stopCodeValue = if ipLifecycleInvariant(st) then &quot;COMPLETE&quot; else &quot;INVARIANT_FAILURE&quot;
 in {scenarioId= #scenarioId cfg,
     runId= #runId cfg,
     baseSeed= #baseSeed cfg,
     modelTime=ipNow(),
     stopCode=stopCodeValue,
     counts= #counts st,
     latency= #latency st,
     metrics=ipRunMetrics(g,rs)}
 end;

fun ipRunComplete(cfg:IP_RUNCFG,st:IP_RUNSTATE) : IP_RUNCOMPLETE =
 {scenarioId= #scenarioId cfg,runId= #runId cfg,
  status=(if ipLifecycleInvariant(st) then &quot;COMPLETE&quot; else &quot;INVARIANT_FAILURE&quot;),atTime=ipNow()};

fun ipEvidenceFinal(cfg:IP_RUNCFG,st:IP_RUNSTATE) : IP_EVIDENCE =
 {runId= #runId cfg,scenarioId= #scenarioId cfg,txId=0,category=&quot;R10_RUN&quot;,
  code=(if ipLifecycleInvariant(st) then &quot;COMPLETE&quot; else &quot;INVARIANT_FAILURE&quot;),
  value= #terminalTx (#pending st),atTime=ipNow()};

fun ipCSVHeader() =
 &quot;scenario_id,run_id,base_seed,model_time,stop_code,submitted_tx,prepared_tx,routed_tx,cross_shard_tx,&quot; ^
 &quot;shard_blocks,eligible_validators,active_committees,committee_recoveries,finality_certificates,root_commitments,&quot; ^
 &quot;receipts,terminal_failures,reward_events,quarantine_events,slashing_events,reconfiguration_events,evidence_count,&quot; ^
 &quot;finality_latency_sum,finality_latency_n,receipt_latency_sum,receipt_latency_n,reward_gini_bp,reward_hhi_bp,&quot; ^
 &quot;nakamoto_coefficient,owner_concentration_bp,shard_load_std_bp\n&quot;;

fun ipCSV(s:IP_RUNSUMMARY) =
 let val c = #counts s
     val l = #latency s
     val m = #metrics s
 in Int.toString(#scenarioId s)^&quot;,&quot;^Int.toString(#runId s)^&quot;,&quot;^Int.toString(#baseSeed s)^&quot;,&quot;^
    Int.toString(#modelTime s)^&quot;,&quot;^(#stopCode s)^&quot;,&quot;^
    Int.toString(#submittedTx c)^&quot;,&quot;^Int.toString(#preparedTx c)^&quot;,&quot;^Int.toString(#routedTx c)^&quot;,&quot;^
    Int.toString(#crossShardTx c)^&quot;,&quot;^Int.toString(#shardBlocks c)^&quot;,&quot;^
    Int.toString(#eligibleValidators c)^&quot;,&quot;^Int.toString(#activeCommittees c)^&quot;,&quot;^
    Int.toString(#committeeRecoveries c)^&quot;,&quot;^Int.toString(#finalityCerts c)^&quot;,&quot;^
    Int.toString(#rootCommits c)^&quot;,&quot;^Int.toString(#receipts c)^&quot;,&quot;^
    Int.toString(#terminalFailures c)^&quot;,&quot;^Int.toString(#rewardEvents c)^&quot;,&quot;^
    Int.toString(#quarantineEvents c)^&quot;,&quot;^Int.toString(#slashingEvents c)^&quot;,&quot;^
    Int.toString(#reconfigurationEvents c)^&quot;,&quot;^Int.toString(#evidenceCount c)^&quot;,&quot;^
    Int.toString(#finalityLatencySum l)^&quot;,&quot;^Int.toString(#finalityLatencyN l)^&quot;,&quot;^
    Int.toString(#receiptLatencySum l)^&quot;,&quot;^Int.toString(#receiptLatencyN l)^&quot;,&quot;^
    Int.toString(#rewardGiniBP m)^&quot;,&quot;^Int.toString(#rewardHHIBP m)^&quot;,&quot;^
    Int.toString(#nakamotoCoefficient m)^&quot;,&quot;^Int.toString(#ownerConcentrationBP m)^&quot;,&quot;^
    Int.toString(#shardLoadStdBP m)^&quot;\n&quot;
 end;

(* Optional native CSV self-logging helper. Use ipSetCSVFile before replications. *)
val ip_csv_file_ref = ref &quot;SPoS_MSC_native_run_summary.csv&quot;;
val ip_csv_header_written_ref = ref false;
fun ipSetCSVFile(path:string) = (ip_csv_file_ref := path; ip_csv_header_written_ref := false);
fun ipResetCSVFile() = ip_csv_header_written_ref := false;
fun ipAppendCSVLine(line:string) =
 let
   val _ = if !ip_csv_header_written_ref then ()
           else let val os0 = TextIO.openOut(!ip_csv_file_ref)
                    val _ = TextIO.output(os0,ipCSVHeader())
                    val _ = TextIO.closeOut(os0)
                in ip_csv_header_written_ref := true end
   val os = TextIO.openAppend(!ip_csv_file_ref)
   val _ = TextIO.output(os,line)
   val _ = TextIO.closeOut(os)
 in line end;
fun ipCSVAndAppend(s:IP_RUNSUMMARY) = ipAppendCSVLine(ipCSV(s));
