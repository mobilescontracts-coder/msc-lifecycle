        <ml id="ID995000646">(* ===== 07_R3_ShardExecution_Proof ===== *)
(* ---------- R3 shard execution/proof ---------- *)
fun ipExecutionOK(cfg:IP_RUNCFG,r:IP_RTX) =
 not(#scenarioId cfg=2 andalso ipPosMod(#txId r+ #runId cfg,23)=0) andalso #battery r&gt;=15 andalso #cpu r&gt;=15;
fun ipBlockDelay(cfg:IP_RUNCFG,r:IP_RTX) = 5 + (if #crossShard r then 5 else 0) + (if #scenarioId cfg=2 then 2 else 0);
fun ipBlockEvidence(cfg:IP_RUNCFG,r:IP_RTX) : IP_BLOCKEV =
 let val d=ipBlockDelay(cfg,r) val bid=ipHash3(#txId r,#routeShard r,#runId cfg)
     val sh=ipHash4(bid,#contractId r,#targetContract r,#amount r)
     val ph=ipHash4(sh,#routeShard r,#txId r,#baseSeed cfg)
 in {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,shardId= #routeShard r,targetShard= #targetShard r,
     blockId=bid,prevHash=ipHash3(#routeShard r,#runId cfg,1),stateHash=sh,proofHash=ph,execOK=true,
     crossShard= #crossShard r,createdAt= #createdAt r,blockAt=ipNow()+d,connectivity= #connectivity r} end;
fun ipUpdateShardProcessed(shards:IP_SHARDLIST,shardId:int) : IP_SHARDLIST =
  case shards of
      [] =&gt; []
    | (shard:IP_SHARDINFO)::remaining =&gt;
        if #sid shard = shardId then
          {sid= #sid shard,load=ipMax(0,#load shard-6),queue=ipMax(0,#queue shard-1),
           latency= #latency shard,capacity= #capacity shard,processed= #processed shard+1}::remaining
        else shard::ipUpdateShardProcessed(remaining,shardId);
fun ipRouteAfterProcess(rs:IP_ROUTESTATE,r:IP_RTX) : IP_ROUTESTATE =
 {shards=ipUpdateShardProcessed(#shards rs,#routeShard r),mapping= #mapping rs,version= #version rs};
fun ipOutcomeRTx(r:IP_RTX,code:string) : IP_OUTCOME =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,status=code,finalAt=ipNow(),evidenceId=ipHash3(#txId r,5,#scenarioId r)};
fun ipEvidenceBlock(r:IP_RTX,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R3_SHARD_EXEC&quot;,code=code,value=value,atTime=ipNow()};
          <layout>(* ===== 07_R3_ShardExecution_Proof ===== *)
(* ---------- R3 shard execution/proof ---------- *)
fun ipExecutionOK(cfg:IP_RUNCFG,r:IP_RTX) =
 not(#scenarioId cfg=2 andalso ipPosMod(#txId r+ #runId cfg,23)=0) andalso #battery r&gt;=15 andalso #cpu r&gt;=15;
fun ipBlockDelay(cfg:IP_RUNCFG,r:IP_RTX) = 5 + (if #crossShard r then 5 else 0) + (if #scenarioId cfg=2 then 2 else 0);
fun ipBlockEvidence(cfg:IP_RUNCFG,r:IP_RTX) : IP_BLOCKEV =
 let val d=ipBlockDelay(cfg,r) val bid=ipHash3(#txId r,#routeShard r,#runId cfg)
     val sh=ipHash4(bid,#contractId r,#targetContract r,#amount r)
     val ph=ipHash4(sh,#routeShard r,#txId r,#baseSeed cfg)
 in {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,shardId= #routeShard r,targetShard= #targetShard r,
     blockId=bid,prevHash=ipHash3(#routeShard r,#runId cfg,1),stateHash=sh,proofHash=ph,execOK=true,
     crossShard= #crossShard r,createdAt= #createdAt r,blockAt=ipNow()+d,connectivity= #connectivity r} end;
fun ipUpdateShardProcessed(shards:IP_SHARDLIST,shardId:int) : IP_SHARDLIST =
  case shards of
      [] =&gt; []
    | (shard:IP_SHARDINFO)::remaining =&gt;
        if #sid shard = shardId then
          {sid= #sid shard,load=ipMax(0,#load shard-6),queue=ipMax(0,#queue shard-1),
           latency= #latency shard,capacity= #capacity shard,processed= #processed shard+1}::remaining
        else shard::ipUpdateShardProcessed(remaining,shardId);
fun ipRouteAfterProcess(rs:IP_ROUTESTATE,r:IP_RTX) : IP_ROUTESTATE =
 {shards=ipUpdateShardProcessed(#shards rs,#routeShard r),mapping= #mapping rs,version= #version rs};
fun ipOutcomeRTx(r:IP_RTX,code:string) : IP_OUTCOME =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,status=code,finalAt=ipNow(),evidenceId=ipHash3(#txId r,5,#scenarioId r)};
fun ipEvidenceBlock(r:IP_RTX,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R3_SHARD_EXEC&quot;,code=code,value=value,atTime=ipNow()};</layout>
        </ml>
        <ml id="ID995000647">(* ===== 08_R7_Voting_QuorumFinality ===== *)
(* ---------- R7 explicit committee voting and quorum ---------- *)
fun ipSameShard(c:IP_COMMITTEE,b:IP_BLOCKEV) = #runId c= #runId b andalso #scenarioId c= #scenarioId b andalso #shardId c= #shardId b;
fun ipProofConsistent(cfg:IP_RUNCFG,b:IP_BLOCKEV) = #execOK b andalso #stateHash b&gt;0 andalso
 #proofHash b = ipHash4(#stateHash b,#shardId b,#txId b,#baseSeed cfg);
fun ipProposal(c:IP_COMMITTEE,b:IP_BLOCKEV) : IP_PROPOSAL =
 {runId= #runId b,scenarioId= #scenarioId b,txId= #txId b,shardId= #shardId b,targetShard= #targetShard b,
  blockId= #blockId b,proofHash= #proofHash b,members= #members c,proposer= #proposer c,quorum= #quorum c,
  createdAt= #createdAt b,connectivity= #connectivity b,crossShard= #crossShard b};
fun ipVoteBehaviour(cfg:IP_RUNCFG,vl:IP_VALLIST,txid:int,vid:int) =
 let val v=ipFindValidator(vl,vid)
 in if #malicious v then ~1 else if #offline v then 0
    else if #scenarioId cfg=6 andalso ipPosMod(txid+vid+ #runId cfg,13)=0 then 0 else 1 end;
fun ipVoteTaskMS(cfg:IP_RUNCFG,vl:IP_VALLIST,p:IP_PROPOSAL,[]) = empty
 | ipVoteTaskMS(cfg,vl,p,vid::vs) =
  1`{runId= #runId p,scenarioId= #scenarioId p,txId= #txId p,shardId= #shardId p,vid=vid,
     behaviour=ipVoteBehaviour(cfg,vl,#txId p,vid),proposer= #proposer p} ++ ipVoteTaskMS(cfg,vl,p,vs);
fun ipGenVoteTasks(cfg:IP_RUNCFG,vl:IP_VALLIST,p:IP_PROPOSAL) = ipVoteTaskMS(cfg,vl,p,#members p);
fun ipInitialVoteState(p:IP_PROPOSAL) : IP_VOTESTATE =
 {runId= #runId p,scenarioId= #scenarioId p,txId= #txId p,shardId= #shardId p,blockId= #blockId p,
  proofHash= #proofHash p,committeeSize=ipLength(#members p),responded=0,yesVotes=0,noVotes=0,yesVoters=[],
  proposer= #proposer p,quorum= #quorum p,createdAt= #createdAt p,connectivity= #connectivity p,crossShard= #crossShard p};
fun ipTaskMatches(t:IP_VOTETASK,s:IP_VOTESTATE) = #runId t= #runId s andalso #txId t= #txId s andalso #shardId t= #shardId s;
fun ipVoteStateUpdate(s:IP_VOTESTATE,t:IP_VOTETASK,yes:int,no:int) : IP_VOTESTATE =
 {runId= #runId s,scenarioId= #scenarioId s,txId= #txId s,shardId= #shardId s,blockId= #blockId s,
  proofHash= #proofHash s,committeeSize= #committeeSize s,responded= #responded s+1,
  yesVotes= #yesVotes s+yes,noVotes= #noVotes s+no,yesVoters=(if yes=1 then ipAddUnique(#vid t,#yesVoters s) else #yesVoters s),
  proposer= #proposer s,quorum= #quorum s,createdAt= #createdAt s,connectivity= #connectivity s,crossShard= #crossShard s};
fun ipVoteEvent(t:IP_VOTETASK,status:string,value:int) : IP_VOTE =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,shardId= #shardId t,vid= #vid t,
  value=value,status=status,atTime=ipNow()};
fun ipPenaltyVote(t:IP_VOTETASK,kind:string,amount:int,slash:bool) : IP_PENALTYTASK =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,vid= #vid t,kind=kind,amount=amount,slashable=slash};
fun ipSecurityVote(t:IP_VOTETASK,kind:string,severity:int) : IP_SECURITY =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,vid= #vid t,kind=kind,severity=severity,atTime=ipNow()};
fun ipEvidenceVoteTask(t:IP_VOTETASK,kind:string,value:int) : IP_EVIDENCE =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,category=&quot;R7_VOTE&quot;,code=kind,value=value,atTime=ipNow()};
fun ipVotesComplete(s:IP_VOTESTATE) = #responded s &gt;= #committeeSize s;
fun ipQuorumReached(s:IP_VOTESTATE) = ipVotesComplete(s) andalso #yesVotes s &gt;= #quorum s;
fun ipFinalityDelay(s:IP_VOTESTATE) = 7 + (if #crossShard s then 4 else 0) + (if #connectivity s=1 then 3 else 0);
fun ipCert(s:IP_VOTESTATE) : IP_CERT =
 let val d=ipFinalityDelay(s) val ch=ipHash4(#txId s,#blockId s,#yesVotes s,#proofHash s)
 in {runId= #runId s,scenarioId= #scenarioId s,txId= #txId s,shardId= #shardId s,blockId= #blockId s,
   proofHash= #proofHash s,certHash=ch,proposer= #proposer s,signers= #yesVoters s,quorum= #quorum s,
   createdAt= #createdAt s,finalityAt=ipNow()+d,connectivity= #connectivity s,crossShard= #crossShard s} end;
fun ipRewardMS(runid:int,scid:int,txid:int,prop:int,[]) =
  if prop=0 then empty else 1`{runId=runid,scenarioId=scid,txId=txid,vid=prop,role=&quot;PROPOSER&quot;,amount=5}
 | ipRewardMS(runid,scid,txid,prop,v::vs) =
  1`{runId=runid,scenarioId=scid,txId=txid,vid=v,role=&quot;VOTER&quot;,amount=2} ++ ipRewardMS(runid,scid,txid,prop,vs);
fun ipFinalityRewards(s:IP_VOTESTATE) = ipRewardMS(#runId s,#scenarioId s,#txId s,#proposer s,#yesVoters s);
fun ipFinalityRewardCount(s:IP_VOTESTATE) = (if #proposer s=0 then 0 else 1)+ipLength(#yesVoters s);
fun ipOutcomeVote(s:IP_VOTESTATE,code:string) : IP_OUTCOME =
 {runId= #runId s,scenarioId= #scenarioId s,txId= #txId s,status=code,finalAt=ipNow(),evidenceId=ipHash3(#txId s,6,#scenarioId s)};
fun ipEvidenceVote(s:IP_VOTESTATE,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId s,scenarioId= #scenarioId s,txId= #txId s,category=&quot;R7_QUORUM&quot;,code=code,value=value,atTime=ipNow()};
fun ipEvidenceProposal(p:IP_PROPOSAL) : IP_EVIDENCE =
 {runId= #runId p,scenarioId= #scenarioId p,txId= #txId p,category=&quot;R7_QUORUM&quot;,code=&quot;VOTING_OPEN&quot;,value=ipLength(#members p),atTime=ipNow()};
          <layout>(* ===== 08_R7_Voting_QuorumFinality ===== *)
(* ---------- R7 explicit committee voting and quorum ---------- *)
fun ipSameShard(c:IP_COMMITTEE,b:IP_BLOCKEV) = #runId c= #runId b andalso #scenarioId c= #scenarioId b andalso #shardId c= #shardId b;
fun ipProofConsistent(cfg:IP_RUNCFG,b:IP_BLOCKEV) = #execOK b andalso #stateHash b&gt;0 andalso
 #proofHash b = ipHash4(#stateHash b,#shardId b,#txId b,#baseSeed cfg);
fun ipProposal(c:IP_COMMITTEE,b:IP_BLOCKEV) : IP_PROPOSAL =
 {runId= #runId b,scenarioId= #scenarioId b,txId= #txId b,shardId= #shardId b,targetShard= #targetShard b,
  blockId= #blockId b,proofHash= #proofHash b,members= #members c,proposer= #proposer c,quorum= #quorum c,
  createdAt= #createdAt b,connectivity= #connectivity b,crossShard= #crossShard b};
fun ipVoteBehaviour(cfg:IP_RUNCFG,vl:IP_VALLIST,txid:int,vid:int) =
 let val v=ipFindValidator(vl,vid)
 in if #malicious v then ~1 else if #offline v then 0
    else if #scenarioId cfg=6 andalso ipPosMod(txid+vid+ #runId cfg,13)=0 then 0 else 1 end;
fun ipVoteTaskMS(cfg:IP_RUNCFG,vl:IP_VALLIST,p:IP_PROPOSAL,[]) = empty
 | ipVoteTaskMS(cfg,vl,p,vid::vs) =
  1`{runId= #runId p,scenarioId= #scenarioId p,txId= #txId p,shardId= #shardId p,vid=vid,
     behaviour=ipVoteBehaviour(cfg,vl,#txId p,vid),proposer= #proposer p} ++ ipVoteTaskMS(cfg,vl,p,vs);
fun ipGenVoteTasks(cfg:IP_RUNCFG,vl:IP_VALLIST,p:IP_PROPOSAL) = ipVoteTaskMS(cfg,vl,p,#members p);
fun ipInitialVoteState(p:IP_PROPOSAL) : IP_VOTESTATE =
 {runId= #runId p,scenarioId= #scenarioId p,txId= #txId p,shardId= #shardId p,blockId= #blockId p,
  proofHash= #proofHash p,committeeSize=ipLength(#members p),responded=0,yesVotes=0,noVotes=0,yesVoters=[],
  proposer= #proposer p,quorum= #quorum p,createdAt= #createdAt p,connectivity= #connectivity p,crossShard= #crossShard p};
fun ipTaskMatches(t:IP_VOTETASK,s:IP_VOTESTATE) = #runId t= #runId s andalso #txId t= #txId s andalso #shardId t= #shardId s;
fun ipVoteStateUpdate(s:IP_VOTESTATE,t:IP_VOTETASK,yes:int,no:int) : IP_VOTESTATE =
 {runId= #runId s,scenarioId= #scenarioId s,txId= #txId s,shardId= #shardId s,blockId= #blockId s,
  proofHash= #proofHash s,committeeSize= #committeeSize s,responded= #responded s+1,
  yesVotes= #yesVotes s+yes,noVotes= #noVotes s+no,yesVoters=(if yes=1 then ipAddUnique(#vid t,#yesVoters s) else #yesVoters s),
  proposer= #proposer s,quorum= #quorum s,createdAt= #createdAt s,connectivity= #connectivity s,crossShard= #crossShard s};
fun ipVoteEvent(t:IP_VOTETASK,status:string,value:int) : IP_VOTE =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,shardId= #shardId t,vid= #vid t,
  value=value,status=status,atTime=ipNow()};
fun ipPenaltyVote(t:IP_VOTETASK,kind:string,amount:int,slash:bool) : IP_PENALTYTASK =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,vid= #vid t,kind=kind,amount=amount,slashable=slash};
fun ipSecurityVote(t:IP_VOTETASK,kind:string,severity:int) : IP_SECURITY =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,vid= #vid t,kind=kind,severity=severity,atTime=ipNow()};
fun ipEvidenceVoteTask(t:IP_VOTETASK,kind:string,value:int) : IP_EVIDENCE =
 {runId= #runId t,scenarioId= #scenarioId t,txId= #txId t,category=&quot;R7_VOTE&quot;,code=kind,value=value,atTime=ipNow()};
fun ipVotesComplete(s:IP_VOTESTATE) = #responded s &gt;= #committeeSize s;
fun ipQuorumReached(s:IP_VOTESTATE) = ipVotesComplete(s) andalso #yesVotes s &gt;= #quorum s;
fun ipFinalityDelay(s:IP_VOTESTATE) = 7 + (if #crossShard s then 4 else 0) + (if #connectivity s=1 then 3 else 0);
fun ipCert(s:IP_VOTESTATE) : IP_CERT =
 let val d=ipFinalityDelay(s) val ch=ipHash4(#txId s,#blockId s,#yesVotes s,#proofHash s)
 in {runId= #runId s,scenarioId= #scenarioId s,txId= #txId s,shardId= #shardId s,blockId= #blockId s,
   proofHash= #proofHash s,certHash=ch,proposer= #proposer s,signers= #yesVoters s,quorum= #quorum s,
   createdAt= #createdAt s,finalityAt=ipNow()+d,connectivity= #connectivity s,crossShard= #crossShard s} end;
fun ipRewardMS(runid:int,scid:int,txid:int,prop:int,[]) =
  if prop=0 then empty else 1`{runId=runid,scenarioId=scid,txId=txid,vid=prop,role=&quot;PROPOSER&quot;,amount=5}
 | ipRewardMS(runid,scid,txid,prop,v::vs) =
  1`{runId=runid,scenarioId=scid,txId=txid,vid=v,role=&quot;VOTER&quot;,amount=2} ++ ipRewardMS(runid,scid,txid,prop,vs);
fun ipFinalityRewards(s:IP_VOTESTATE) = ipRewardMS(#runId s,#scenarioId s,#txId s,#proposer s,#yesVoters s);
fun ipFinalityRewardCount(s:IP_VOTESTATE) = (if #proposer s=0 then 0 else 1)+ipLength(#yesVoters s);
fun ipOutcomeVote(s:IP_VOTESTATE,code:string) : IP_OUTCOME =
 {runId= #runId s,scenarioId= #scenarioId s,txId= #txId s,status=code,finalAt=ipNow(),evidenceId=ipHash3(#txId s,6,#scenarioId s)};
fun ipEvidenceVote(s:IP_VOTESTATE,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId s,scenarioId= #scenarioId s,txId= #txId s,category=&quot;R7_QUORUM&quot;,code=code,value=value,atTime=ipNow()};
fun ipEvidenceProposal(p:IP_PROPOSAL) : IP_EVIDENCE =
 {runId= #runId p,scenarioId= #scenarioId p,txId= #txId p,category=&quot;R7_QUORUM&quot;,code=&quot;VOTING_OPEN&quot;,value=ipLength(#members p),atTime=ipNow()};</layout>
        </ml>
        <ml id="ID995000648">(* ===== 09_R3_R4_RootCommitment_Receipt ===== *)
(* ---------- R3/R4 root commitment and mobile receipt ---------- *)
fun ipCertMatchesBlock(c:IP_CERT,b:IP_BLOCKEV) = #runId c= #runId b andalso #txId c= #txId b andalso #shardId c= #shardId b
 andalso #blockId c= #blockId b andalso #proofHash c= #proofHash b;
fun ipCertValid(c:IP_CERT) = ipLength(#signers c)&gt;= #quorum c andalso #certHash c=ipHash4(#txId c,#blockId c,ipLength(#signers c),#proofHash c);
fun ipRootDelay(c:IP_CERT) = 10 + (if #crossShard c then 4 else 0);
fun ipRootCommit(c:IP_CERT) : IP_ROOT =
 let val d=ipRootDelay(c) val h=ipHash4(#certHash c,#proofHash c,#txId c,#shardId c)
 in {runId= #runId c,scenarioId= #scenarioId c,txId= #txId c,shardId= #shardId c,
  rootHeight=100000+ #txId c,rootHash=h,certHash= #certHash c,proofHash= #proofHash c,
  createdAt= #createdAt c,commitAt=ipNow()+d,connectivity= #connectivity c,crossShard= #crossShard c,proposer= #proposer c} end;
fun ipOutcomeCert(c:IP_CERT,code:string) : IP_OUTCOME =
 {runId= #runId c,scenarioId= #scenarioId c,txId= #txId c,status=code,finalAt=ipNow(),evidenceId=ipHash3(#txId c,7,#scenarioId c)};
fun ipEvidenceRoot(c:IP_CERT,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId c,scenarioId= #scenarioId c,txId= #txId c,category=&quot;R3_ROOT&quot;,code=code,value=value,atTime=ipNow()};
fun ipReceiptDelay(r:IP_ROOT) = 1 + (if #connectivity r=1 then 8 else 2) + (if #crossShard r then 2 else 0);
fun ipDeliveryOK(cfg:IP_RUNCFG,r:IP_ROOT) = #connectivity r&gt;0 andalso
  not(#scenarioId cfg=4 andalso ipPosMod(#txId r+ #runId cfg,7)&lt;2) andalso ipNow()+ipReceiptDelay(r)&lt;= #maxTime cfg;
fun ipReceipt(r:IP_ROOT) : IP_RECEIPT =
 let val delivered=ipNow()
 in {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,rootHash= #rootHash r,proofHash= #proofHash r,
     status=&quot;FINAL&quot;,verified=(#rootHash r=ipHash4(#certHash r,#proofHash r,#txId r,#shardId r)),
     deliveredAt=delivered,latency=delivered- #createdAt r} end;
fun ipOutcomeRoot(r:IP_ROOT,code:string) : IP_OUTCOME =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,status=code,finalAt=ipNow(),evidenceId=ipHash3(#txId r,8,#scenarioId r)};
fun ipReceiptReward(r:IP_ROOT) : IP_REWARDTASK =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,vid= #proposer r,role=&quot;RECEIPT&quot;,amount=2};
fun ipEvidenceReceipt(r:IP_ROOT,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R4_RECEIPT&quot;,code=code,value=value,atTime=ipNow()};
