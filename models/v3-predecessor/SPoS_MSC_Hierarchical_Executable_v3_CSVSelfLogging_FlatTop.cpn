        <ml id="ID995000640">(* ===== 01_Parameters_Utilities_RunState ===== *)
(* ================================================================
   Corrected SPoS-MSC executable semantics (R1--R10; hierarchical revision 2)
   Prefix IP_ avoids clashes with legacy declarations.
   Symbolic hashes/VRF are model-level abstractions, not production crypto.
   ================================================================ *)

val ip_scenario_ref = ref 1;
val ip_run_ref = ref 0;
val ip_base_seed_ref = ref 626;
val ip_tx_override_ref = ref 0;
val ip_validator_override_ref = ref 0;

fun ipSetScenario(q:int) = if q &gt;= 1 andalso q &lt;= 7 then ip_scenario_ref := q else raise Fail &quot;Scenario must be Q1..Q7&quot;;
fun ipResetRunCounter() = ip_run_ref := 0;
fun ipSetBaseSeed(s:int) = ip_base_seed_ref := s;
fun ipSetTxOverride(n:int) = if n &gt;= 0 then ip_tx_override_ref := n else raise Fail &quot;Transaction override must be non-negative&quot;;
fun ipSetValidatorOverride(n:int) = if n &gt;= 0 then ip_validator_override_ref := n else raise Fail &quot;Validator override must be non-negative&quot;;
fun ipClearOverrides() = (ip_tx_override_ref := 0; ip_validator_override_ref := 0);
fun ipNextRunId() = (ip_run_ref := !ip_run_ref + 1; !ip_run_ref);

fun ipMin(a:int,b:int) = if a &lt; b then a else b;
fun ipMax(a:int,b:int) = if a &gt; b then a else b;
fun ipAbs(x:int) = if x &lt; 0 then ~x else x;
fun ipPosMod(x:int,m:int) = let val r=x mod m in if r &lt; 0 then r+m else r end;
fun ipISqrt(n:int) =
  let fun loop(x:int) = if (x+1)*(x+1) &gt; n then x else loop(x+1)
  in if n &lt;= 0 then 0 else loop(0) end;
fun ipHash3(a:int,b:int,c:int) = ipPosMod(ipPosMod(a,7919)*127 + ipPosMod(b,7919)*257 + ipPosMod(c,7919)*521 + 1049, 2147483);
fun ipHash4(a:int,b:int,c:int,d:int) = ipHash3(ipHash3(a,b,c),d,7919);
fun ipNow() : int = IntInf.toInt (time());
fun ipBoolInt (b:bool) : int = if b then 1 else 0;
fun ipSumInt (values:IP_INTLIST) : int =
  case values of [] =&gt; 0 | x::remaining =&gt; x + ipSumInt remaining;
fun ipLength (values:IP_INTLIST) : int = List.length values;
fun ipMember (x:int,values:IP_INTLIST) : bool =
  case values of [] =&gt; false | y::remaining =&gt; (x = y) orelse ipMember(x,remaining);
fun ipAddUnique (x:int,values:IP_INTLIST) : IP_INTLIST =
  if ipMember(x,values) then values else x::values;
fun ipTake (n:int,values:IP_INTLIST) : IP_INTLIST =
  if n &lt;= 0 then []
  else case values of [] =&gt; [] | x::remaining =&gt; x::ipTake(n-1,remaining);
fun ipDrop (n:int,values:IP_INTLIST) : IP_INTLIST =
  if n &lt;= 0 then values
  else case values of [] =&gt; [] | _::remaining =&gt; ipDrop(n-1,remaining);

fun ipScenarioName (q:int) : string =
  if q=1 then &quot;Q1_NORMAL&quot; else if q=2 then &quot;Q2_HIGH_LOAD&quot; else if q=3 then &quot;Q3_CROSS_SHARD&quot;
  else if q=4 then &quot;Q4_POOR_CONNECTIVITY&quot; else if q=5 then &quot;Q5_STAKE_SKEW&quot;
  else if q=6 then &quot;Q6_RISKY_OFFLINE&quot; else &quot;Q7_HOT_SHARD&quot;;

fun ipMakeConfig(q:int,runid:int) : IP_RUNCFG =
  let val scenarioTx = if q=2 then 40 else if q=7 then 32 else if q=3 then 28 else 24
      val ntx = if !ip_tx_override_ref &gt; 0 then !ip_tx_override_ref else scenarioTx
      val nv = if !ip_validator_override_ref &gt; 0 then !ip_validator_override_ref else 10
      val csize = if q=6 then 4 else 3
      val quorum = if csize=4 then 3 else 2
      val threshold = if q=7 then 55 else 75
      val maxt = if q=4 then 240 else 180
  in {runId=runid,scenarioId=q,baseSeed=(!ip_base_seed_ref),nTx=ntx,nValidators=nv,
      nShards=4,committeeSize=csize,quorum=quorum,loadThreshold=threshold,maxTime=maxt}
  end;

fun ipCurrentConfig() = ipMakeConfig(!ip_scenario_ref,ipNextRunId());

fun ipEmptyPending(cfg:IP_RUNCFG) : IP_PENDING =
 {expectedTx=(#nTx cfg),terminalTx=0,expectedVal=(#nValidators cfg),evaluatedVal=0,
  pendingRewards=0,pendingPenalties=0,pendingReconfigs=0};
fun ipEmptyCounts(cfg:IP_RUNCFG) : IP_COUNTS =
 {submittedTx=(#nTx cfg),preparedTx=0,routedTx=0,crossShardTx=0,shardBlocks=0,
  eligibleValidators=0,activeCommittees=0,committeeRecoveries=0,finalityCerts=0,
  rootCommits=0,receipts=0,terminalFailures=0,rewardEvents=0,quarantineEvents=0,
  slashingEvents=0,reconfigurationEvents=0,evidenceCount=1};
fun ipEmptyLatency() : IP_LATENCY =
 {finalityLatencySum=0,finalityLatencyN=0,receiptLatencySum=0,receiptLatencyN=0};
fun ipInitialState(cfg:IP_RUNCFG) : IP_RUNSTATE =
 {runId=(#runId cfg),scenarioId=(#scenarioId cfg),pending=ipEmptyPending(cfg),counts=ipEmptyCounts(cfg),
  latency=ipEmptyLatency(),committeesBuilt=false,finalized=false};

fun ipStateWith(st:IP_RUNSTATE,p:IP_PENDING,c:IP_COUNTS,l:IP_LATENCY,cb:bool,fin:bool) : IP_RUNSTATE =
 {runId=(#runId st),scenarioId=(#scenarioId st),pending=p,counts=c,latency=l,committeesBuilt=cb,finalized=fin};

fun ipPendingWith(p:IP_PENDING,terminal:int,eval:int,pr:int,pp:int,pc:int) : IP_PENDING =
 {expectedTx=(#expectedTx p),terminalTx=terminal,expectedVal=(#expectedVal p),evaluatedVal=eval,
  pendingRewards=pr,pendingPenalties=pp,pendingReconfigs=pc};

fun ipCountsWith(c:IP_COUNTS,prepared:int,routed:int,cross:int,blocks:int,eligible:int,comms:int,recoveries:int,
                 finals:int,roots:int,receipts:int,failures:int,rewards:int,quars:int,slashes:int,reconfigs:int,evid:int) : IP_COUNTS =
 {submittedTx=(#submittedTx c),preparedTx=prepared,routedTx=routed,crossShardTx=cross,shardBlocks=blocks,
  eligibleValidators=eligible,activeCommittees=comms,committeeRecoveries=recoveries,finalityCerts=finals,
  rootCommits=roots,receipts=receipts,terminalFailures=failures,rewardEvents=rewards,quarantineEvents=quars,
  slashingEvents=slashes,reconfigurationEvents=reconfigs,evidenceCount=evid};

fun ipStatePrepared(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st in
  ipStateWith(st,p,ipCountsWith(c,#preparedTx c+1,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
   #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
   #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1),#latency st,#committeesBuilt st,#finalized st)
 end;

fun ipStateTerminalFailure(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p+1,#evaluatedVal p,#pendingRewards p,#pendingPenalties p,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
      #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c+1,
      #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateRouted(st:IP_RUNSTATE,cross:bool,reconf:bool) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p,#pendingPenalties p,
                #pendingReconfigs p + (if reconf then 1 else 0))
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c+1,#crossShardTx c+(if cross then 1 else 0),#shardBlocks c,
      #eligibleValidators c,#activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,
      #terminalFailures c,#rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateReconfigured(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p,#pendingPenalties p,ipMax(0,#pendingReconfigs p-1))
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
      #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
      #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c+1,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateValidator(st:IP_RUNSTATE,eligible:bool,quarantine:bool,slash:bool,penaltyPending:bool) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p+1,#pendingRewards p,
       #pendingPenalties p+(if penaltyPending then 1 else 0),#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,
       #eligibleValidators c+(if eligible then 1 else 0),#activeCommittees c,#committeeRecoveries c,#finalityCerts c,
       #rootCommits c,#receipts c,#terminalFailures c,#rewardEvents c,
       #quarantineEvents c+(if quarantine then 1 else 0),#slashingEvents c+(if slash then 1 else 0),
       #reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateCommittees(st:IP_RUNSTATE,active:int,recovered:int) =
 let val c= #counts st
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       active,recovered,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,#rewardEvents c,
       #quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,#pending st,c2,#latency st,true,#finalized st) end;

fun ipStateBlock(st:IP_RUNSTATE) =
 let val c= #counts st
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c+1,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,#pending st,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateEvidenceOnly(st:IP_RUNSTATE) =
 let val c= #counts st
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,#pending st,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateVotePenaltyQueued(st:IP_RUNSTATE,slash:bool) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p,#pendingPenalties p+1,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c+(if slash then 1 else 0),#slashingEvents c+(if slash then 1 else 0),
       #reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateFinality(st:IP_RUNSTATE,lat:int,nRewards:int) =
 let val p= #pending st and c= #counts st and l= #latency st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p+nRewards,#pendingPenalties p,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c+1,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
     val l2={finalityLatencySum=(#finalityLatencySum l)+lat,finalityLatencyN=(#finalityLatencyN l)+1,
             receiptLatencySum=(#receiptLatencySum l),receiptLatencyN=(#receiptLatencyN l)}
 in ipStateWith(st,p2,c2,l2,#committeesBuilt st,#finalized st) end;

fun ipStateRoot(st:IP_RUNSTATE) =
 let val c= #counts st
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c+1,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,#pending st,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateReceipt(st:IP_RUNSTATE,lat:int) =
 let val p= #pending st and c= #counts st and l= #latency st
     val p2=ipPendingWith(p,#terminalTx p+1,#evaluatedVal p,#pendingRewards p+1,#pendingPenalties p,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c+1,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
     val l2={finalityLatencySum=(#finalityLatencySum l),finalityLatencyN=(#finalityLatencyN l),
             receiptLatencySum=(#receiptLatencySum l)+lat,receiptLatencyN=(#receiptLatencyN l)+1}
 in ipStateWith(st,p2,c2,l2,#committeesBuilt st,#finalized st) end;

fun ipStateRewardApplied(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,ipMax(0,#pendingRewards p-1),#pendingPenalties p,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c+1,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStatePenaltyApplied(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p,ipMax(0,#pendingPenalties p-1),#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateFinalized(st:IP_RUNSTATE) =
 let val s2=ipStateEvidenceOnly(st)
 in ipStateWith(s2,#pending s2,#counts s2,#latency s2,#committeesBuilt s2,true) end;
          <layout>(* ===== 01_Parameters_Utilities_RunState ===== *)
(* ================================================================
   Corrected SPoS-MSC executable semantics (R1--R10; hierarchical revision 2)
   Prefix IP_ avoids clashes with legacy declarations.
   Symbolic hashes/VRF are model-level abstractions, not production crypto.
   ================================================================ *)

val ip_scenario_ref = ref 1;
val ip_run_ref = ref 0;
val ip_base_seed_ref = ref 626;
val ip_tx_override_ref = ref 0;
val ip_validator_override_ref = ref 0;

fun ipSetScenario(q:int) = if q &gt;= 1 andalso q &lt;= 7 then ip_scenario_ref := q else raise Fail &quot;Scenario must be Q1..Q7&quot;;
fun ipResetRunCounter() = ip_run_ref := 0;
fun ipSetBaseSeed(s:int) = ip_base_seed_ref := s;
fun ipSetTxOverride(n:int) = if n &gt;= 0 then ip_tx_override_ref := n else raise Fail &quot;Transaction override must be non-negative&quot;;
fun ipSetValidatorOverride(n:int) = if n &gt;= 0 then ip_validator_override_ref := n else raise Fail &quot;Validator override must be non-negative&quot;;
fun ipClearOverrides() = (ip_tx_override_ref := 0; ip_validator_override_ref := 0);
fun ipNextRunId() = (ip_run_ref := !ip_run_ref + 1; !ip_run_ref);

fun ipMin(a:int,b:int) = if a &lt; b then a else b;
fun ipMax(a:int,b:int) = if a &gt; b then a else b;
fun ipAbs(x:int) = if x &lt; 0 then ~x else x;
fun ipPosMod(x:int,m:int) = let val r=x mod m in if r &lt; 0 then r+m else r end;
fun ipISqrt(n:int) =
  let fun loop(x:int) = if (x+1)*(x+1) &gt; n then x else loop(x+1)
  in if n &lt;= 0 then 0 else loop(0) end;
fun ipHash3(a:int,b:int,c:int) = ipPosMod(ipPosMod(a,7919)*127 + ipPosMod(b,7919)*257 + ipPosMod(c,7919)*521 + 1049, 2147483);
fun ipHash4(a:int,b:int,c:int,d:int) = ipHash3(ipHash3(a,b,c),d,7919);
fun ipNow() : int = IntInf.toInt (time());
fun ipBoolInt (b:bool) : int = if b then 1 else 0;
fun ipSumInt (values:IP_INTLIST) : int =
  case values of [] =&gt; 0 | x::remaining =&gt; x + ipSumInt remaining;
fun ipLength (values:IP_INTLIST) : int = List.length values;
fun ipMember (x:int,values:IP_INTLIST) : bool =
  case values of [] =&gt; false | y::remaining =&gt; (x = y) orelse ipMember(x,remaining);
fun ipAddUnique (x:int,values:IP_INTLIST) : IP_INTLIST =
  if ipMember(x,values) then values else x::values;
fun ipTake (n:int,values:IP_INTLIST) : IP_INTLIST =
  if n &lt;= 0 then []
  else case values of [] =&gt; [] | x::remaining =&gt; x::ipTake(n-1,remaining);
fun ipDrop (n:int,values:IP_INTLIST) : IP_INTLIST =
  if n &lt;= 0 then values
  else case values of [] =&gt; [] | _::remaining =&gt; ipDrop(n-1,remaining);

fun ipScenarioName (q:int) : string =
  if q=1 then &quot;Q1_NORMAL&quot; else if q=2 then &quot;Q2_HIGH_LOAD&quot; else if q=3 then &quot;Q3_CROSS_SHARD&quot;
  else if q=4 then &quot;Q4_POOR_CONNECTIVITY&quot; else if q=5 then &quot;Q5_STAKE_SKEW&quot;
  else if q=6 then &quot;Q6_RISKY_OFFLINE&quot; else &quot;Q7_HOT_SHARD&quot;;

fun ipMakeConfig(q:int,runid:int) : IP_RUNCFG =
  let val scenarioTx = if q=2 then 40 else if q=7 then 32 else if q=3 then 28 else 24
      val ntx = if !ip_tx_override_ref &gt; 0 then !ip_tx_override_ref else scenarioTx
      val nv = if !ip_validator_override_ref &gt; 0 then !ip_validator_override_ref else 10
      val csize = if q=6 then 4 else 3
      val quorum = if csize=4 then 3 else 2
      val threshold = if q=7 then 55 else 75
      val maxt = if q=4 then 240 else 180
  in {runId=runid,scenarioId=q,baseSeed=(!ip_base_seed_ref),nTx=ntx,nValidators=nv,
      nShards=4,committeeSize=csize,quorum=quorum,loadThreshold=threshold,maxTime=maxt}
  end;

fun ipCurrentConfig() = ipMakeConfig(!ip_scenario_ref,ipNextRunId());

fun ipEmptyPending(cfg:IP_RUNCFG) : IP_PENDING =
 {expectedTx=(#nTx cfg),terminalTx=0,expectedVal=(#nValidators cfg),evaluatedVal=0,
  pendingRewards=0,pendingPenalties=0,pendingReconfigs=0};
fun ipEmptyCounts(cfg:IP_RUNCFG) : IP_COUNTS =
 {submittedTx=(#nTx cfg),preparedTx=0,routedTx=0,crossShardTx=0,shardBlocks=0,
  eligibleValidators=0,activeCommittees=0,committeeRecoveries=0,finalityCerts=0,
  rootCommits=0,receipts=0,terminalFailures=0,rewardEvents=0,quarantineEvents=0,
  slashingEvents=0,reconfigurationEvents=0,evidenceCount=1};
fun ipEmptyLatency() : IP_LATENCY =
 {finalityLatencySum=0,finalityLatencyN=0,receiptLatencySum=0,receiptLatencyN=0};
fun ipInitialState(cfg:IP_RUNCFG) : IP_RUNSTATE =
 {runId=(#runId cfg),scenarioId=(#scenarioId cfg),pending=ipEmptyPending(cfg),counts=ipEmptyCounts(cfg),
  latency=ipEmptyLatency(),committeesBuilt=false,finalized=false};

fun ipStateWith(st:IP_RUNSTATE,p:IP_PENDING,c:IP_COUNTS,l:IP_LATENCY,cb:bool,fin:bool) : IP_RUNSTATE =
 {runId=(#runId st),scenarioId=(#scenarioId st),pending=p,counts=c,latency=l,committeesBuilt=cb,finalized=fin};

fun ipPendingWith(p:IP_PENDING,terminal:int,eval:int,pr:int,pp:int,pc:int) : IP_PENDING =
 {expectedTx=(#expectedTx p),terminalTx=terminal,expectedVal=(#expectedVal p),evaluatedVal=eval,
  pendingRewards=pr,pendingPenalties=pp,pendingReconfigs=pc};

fun ipCountsWith(c:IP_COUNTS,prepared:int,routed:int,cross:int,blocks:int,eligible:int,comms:int,recoveries:int,
                 finals:int,roots:int,receipts:int,failures:int,rewards:int,quars:int,slashes:int,reconfigs:int,evid:int) : IP_COUNTS =
 {submittedTx=(#submittedTx c),preparedTx=prepared,routedTx=routed,crossShardTx=cross,shardBlocks=blocks,
  eligibleValidators=eligible,activeCommittees=comms,committeeRecoveries=recoveries,finalityCerts=finals,
  rootCommits=roots,receipts=receipts,terminalFailures=failures,rewardEvents=rewards,quarantineEvents=quars,
  slashingEvents=slashes,reconfigurationEvents=reconfigs,evidenceCount=evid};

fun ipStatePrepared(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st in
  ipStateWith(st,p,ipCountsWith(c,#preparedTx c+1,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
   #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
   #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1),#latency st,#committeesBuilt st,#finalized st)
 end;

fun ipStateTerminalFailure(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p+1,#evaluatedVal p,#pendingRewards p,#pendingPenalties p,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
      #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c+1,
      #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateRouted(st:IP_RUNSTATE,cross:bool,reconf:bool) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p,#pendingPenalties p,
                #pendingReconfigs p + (if reconf then 1 else 0))
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c+1,#crossShardTx c+(if cross then 1 else 0),#shardBlocks c,
      #eligibleValidators c,#activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,
      #terminalFailures c,#rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateReconfigured(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p,#pendingPenalties p,ipMax(0,#pendingReconfigs p-1))
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
      #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
      #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c+1,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateValidator(st:IP_RUNSTATE,eligible:bool,quarantine:bool,slash:bool,penaltyPending:bool) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p+1,#pendingRewards p,
       #pendingPenalties p+(if penaltyPending then 1 else 0),#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,
       #eligibleValidators c+(if eligible then 1 else 0),#activeCommittees c,#committeeRecoveries c,#finalityCerts c,
       #rootCommits c,#receipts c,#terminalFailures c,#rewardEvents c,
       #quarantineEvents c+(if quarantine then 1 else 0),#slashingEvents c+(if slash then 1 else 0),
       #reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateCommittees(st:IP_RUNSTATE,active:int,recovered:int) =
 let val c= #counts st
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       active,recovered,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,#rewardEvents c,
       #quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,#pending st,c2,#latency st,true,#finalized st) end;

fun ipStateBlock(st:IP_RUNSTATE) =
 let val c= #counts st
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c+1,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,#pending st,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateEvidenceOnly(st:IP_RUNSTATE) =
 let val c= #counts st
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,#pending st,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateVotePenaltyQueued(st:IP_RUNSTATE,slash:bool) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p,#pendingPenalties p+1,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c+(if slash then 1 else 0),#slashingEvents c+(if slash then 1 else 0),
       #reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateFinality(st:IP_RUNSTATE,lat:int,nRewards:int) =
 let val p= #pending st and c= #counts st and l= #latency st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p+nRewards,#pendingPenalties p,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c+1,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
     val l2={finalityLatencySum=(#finalityLatencySum l)+lat,finalityLatencyN=(#finalityLatencyN l)+1,
             receiptLatencySum=(#receiptLatencySum l),receiptLatencyN=(#receiptLatencyN l)}
 in ipStateWith(st,p2,c2,l2,#committeesBuilt st,#finalized st) end;

fun ipStateRoot(st:IP_RUNSTATE) =
 let val c= #counts st
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c+1,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,#pending st,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateReceipt(st:IP_RUNSTATE,lat:int) =
 let val p= #pending st and c= #counts st and l= #latency st
     val p2=ipPendingWith(p,#terminalTx p+1,#evaluatedVal p,#pendingRewards p+1,#pendingPenalties p,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c+1,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
     val l2={finalityLatencySum=(#finalityLatencySum l),finalityLatencyN=(#finalityLatencyN l),
             receiptLatencySum=(#receiptLatencySum l)+lat,receiptLatencyN=(#receiptLatencyN l)+1}
 in ipStateWith(st,p2,c2,l2,#committeesBuilt st,#finalized st) end;

fun ipStateRewardApplied(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,ipMax(0,#pendingRewards p-1),#pendingPenalties p,#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c+1,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStatePenaltyApplied(st:IP_RUNSTATE) =
 let val p= #pending st and c= #counts st
     val p2=ipPendingWith(p,#terminalTx p,#evaluatedVal p,#pendingRewards p,ipMax(0,#pendingPenalties p-1),#pendingReconfigs p)
     val c2=ipCountsWith(c,#preparedTx c,#routedTx c,#crossShardTx c,#shardBlocks c,#eligibleValidators c,
       #activeCommittees c,#committeeRecoveries c,#finalityCerts c,#rootCommits c,#receipts c,#terminalFailures c,
       #rewardEvents c,#quarantineEvents c,#slashingEvents c,#reconfigurationEvents c,#evidenceCount c+1)
 in ipStateWith(st,p2,c2,#latency st,#committeesBuilt st,#finalized st) end;

fun ipStateFinalized(st:IP_RUNSTATE) =
 let val s2=ipStateEvidenceOnly(st)
 in ipStateWith(s2,#pending s2,#counts s2,#latency s2,#committeesBuilt s2,true) end;</layout>
        </ml>
        <ml id="ID995000641">(* ===== 02_Q1_Q7_ScenarioGeneration ===== *)
(* ---------- Q1--Q7 request and validator generation ---------- *)
fun ipReqConnectivity(cfg:IP_RUNCFG,i:int) =
  if #scenarioId cfg=4 then (if ipPosMod(i + #runId cfg,5)=0 then 0 else 1)
  else if ipPosMod(i,9)=0 then 1 else 2;
fun ipReqValid(cfg:IP_RUNCFG,i:int) = not(#scenarioId cfg=4 andalso ipPosMod(i+ #runId cfg,11)=0);
fun ipContract(cfg:IP_RUNCFG,i:int) = if #scenarioId cfg=7 then 1 + ipPosMod(i,2) else 1 + ipPosMod(i*7+ #baseSeed cfg,16);
fun ipTargetContract(cfg:IP_RUNCFG,i:int) =
  if #scenarioId cfg=3 andalso ipPosMod(i,10)&lt;6 then 1 + ipPosMod(ipContract(cfg,i)+5,16)
  else ipContract(cfg,i);
fun ipMkReq(cfg:IP_RUNCFG,i:int) : IP_MREQ =
 let val good=ipReqValid(cfg,i)
 in {runId= #runId cfg,scenarioId= #scenarioId cfg,txId=100000*(#scenarioId cfg)+1000*(#runId cfg)+i,
     contractId=ipContract(cfg,i),targetContract=ipTargetContract(cfg,i),userId=100+i,amount=1+ipPosMod(i,5),
     signatureOK=good,walletOK=true,depositOK=good,edgeOK=true,battery=35+ipPosMod(i*13,60),
     cpu=30+ipPosMod(i*17,65),connectivity=ipReqConnectivity(cfg,i),createdAt=0}
 end;
fun ipReqMS(cfg:IP_RUNCFG,i:int) = if i &gt; #nTx cfg then empty else 1`(ipMkReq(cfg,i)) ++ ipReqMS(cfg,i+1);
fun ipReqArchiveMS(cfg:IP_RUNCFG,i:int) = if i &gt; #nTx cfg then empty else 1`(ipMkReq(cfg,i)) ++ ipReqArchiveMS(cfg,i+1);
fun ipGenRequests(cfg:IP_RUNCFG) = ipReqMS(cfg,1);
fun ipGenRequestArchive(cfg:IP_RUNCFG) = ipReqArchiveMS(cfg,1);

fun ipOwner(cfg:IP_RUNCFG,vid:int) =
 if #scenarioId cfg=5 andalso vid&lt;=3 then 1 else if vid=1 orelse vid=2 then 1 else vid;
fun ipStake(cfg:IP_RUNCFG,vid:int) =
 if #scenarioId cfg=5 then (if vid&lt;=3 then 2500+vid*400 else 60+vid*17)
 else if vid=3 then 900 else 100+ipPosMod(vid*83+ #baseSeed cfg,550);
fun ipMalicious(cfg:IP_RUNCFG,vid:int) = #scenarioId cfg=6 andalso (vid=3 orelse vid=7);
fun ipOffline(cfg:IP_RUNCFG,vid:int) = #scenarioId cfg=6 andalso (vid=4 orelse vid=8);
fun ipMkValidator(cfg:IP_RUNCFG,vid:int) : IP_VALIDATOR =
 {runId= #runId cfg,scenarioId= #scenarioId cfg,vid=vid,owner=ipOwner(cfg,vid),stake=ipStake(cfg,vid),
  battery=(if ipOffline(cfg,vid) then 15 else 55+ipPosMod(vid*11,40)),
  cpu=(if ipOffline(cfg,vid) then 18 else 50+ipPosMod(vid*7,45)),
  bandwidth=(if ipOffline(cfg,vid) then 10 else 50+ipPosMod(vid*19,50)),
  latency=(if ipOffline(cfg,vid) then 90 else 10+ipPosMod(vid*13,35)),
  availability=(if ipOffline(cfg,vid) then 20 else 75+ipPosMod(vid*9,25)),
  risk=(if ipMalicious(cfg,vid) then 90 else 5+ipPosMod(vid*7,28)),
  malicious=ipMalicious(cfg,vid),offline=ipOffline(cfg,vid)};
fun ipValList(cfg:IP_RUNCFG,i:int) = if i &gt; #nValidators cfg then [] else ipMkValidator(cfg,i)::ipValList(cfg,i+1);
fun ipValMS(cfg:IP_RUNCFG,i:int) = if i &gt; #nValidators cfg then empty else 1`(ipMkValidator(cfg,i)) ++ ipValMS(cfg,i+1);
fun ipGenValidators(cfg:IP_RUNCFG) = ipValMS(cfg,1);
fun ipValidatorList(cfg:IP_RUNCFG) = ipValList(cfg,1);

fun ipBalances(validators:IP_VALLIST) : IP_BALANCELIST =
  case validators of
      [] =&gt; []
    | (validator:IP_VALIDATOR)::remaining =&gt;
        {vid= #vid validator,owner= #owner validator,stake= #stake validator,reward=0,penalty=0}
        :: ipBalances(remaining);
fun ipInitialGov(cfg:IP_RUNCFG) : IP_GOVSTATE =
 {scores=[],balances=ipBalances(ipValidatorList(cfg)),quarantined=[],slashed=[],committeesBuilt=false};

fun ipInitialShard(cfg:IP_RUNCFG,sid:int) : IP_SHARDINFO =
 {sid=sid,load=(if #scenarioId cfg=7 andalso sid=1 then 48 else 10+sid*4),queue=0,
  latency=(if #scenarioId cfg=4 then 8+sid else 2+sid),capacity=(if sid=1 then 100 else 90),processed=0};
fun ipShardList(cfg:IP_RUNCFG,sid:int) = if sid &gt; #nShards cfg then [] else ipInitialShard(cfg,sid)::ipShardList(cfg,sid+1);
fun ipMapList(cfg:IP_RUNCFG,cid:int) = if cid&gt;16 then [] else
  {contractId=cid,sid=(if #scenarioId cfg=7 andalso cid&lt;=10 then 1 else 1+ipPosMod(cid-1,#nShards cfg))}::ipMapList(cfg,cid+1);
fun ipInitialRouteState(cfg:IP_RUNCFG) : IP_ROUTESTATE = {shards=ipShardList(cfg,1),mapping=ipMapList(cfg,1),version=1};

fun ipScenarioEvidence(cfg:IP_RUNCFG) =
  1`{runId= #runId cfg,scenarioId= #scenarioId cfg,txId=0,category=&quot;CONFIG&quot;,code=ipScenarioName(#scenarioId cfg),
     value= #nTx cfg,atTime=ipNow()};
          <layout>(* ===== 02_Q1_Q7_ScenarioGeneration ===== *)
(* ---------- Q1--Q7 request and validator generation ---------- *)
fun ipReqConnectivity(cfg:IP_RUNCFG,i:int) =
  if #scenarioId cfg=4 then (if ipPosMod(i + #runId cfg,5)=0 then 0 else 1)
  else if ipPosMod(i,9)=0 then 1 else 2;
fun ipReqValid(cfg:IP_RUNCFG,i:int) = not(#scenarioId cfg=4 andalso ipPosMod(i+ #runId cfg,11)=0);
fun ipContract(cfg:IP_RUNCFG,i:int) = if #scenarioId cfg=7 then 1 + ipPosMod(i,2) else 1 + ipPosMod(i*7+ #baseSeed cfg,16);
fun ipTargetContract(cfg:IP_RUNCFG,i:int) =
  if #scenarioId cfg=3 andalso ipPosMod(i,10)&lt;6 then 1 + ipPosMod(ipContract(cfg,i)+5,16)
  else ipContract(cfg,i);
fun ipMkReq(cfg:IP_RUNCFG,i:int) : IP_MREQ =
 let val good=ipReqValid(cfg,i)
 in {runId= #runId cfg,scenarioId= #scenarioId cfg,txId=100000*(#scenarioId cfg)+1000*(#runId cfg)+i,
     contractId=ipContract(cfg,i),targetContract=ipTargetContract(cfg,i),userId=100+i,amount=1+ipPosMod(i,5),
     signatureOK=good,walletOK=true,depositOK=good,edgeOK=true,battery=35+ipPosMod(i*13,60),
     cpu=30+ipPosMod(i*17,65),connectivity=ipReqConnectivity(cfg,i),createdAt=0}
 end;
fun ipReqMS(cfg:IP_RUNCFG,i:int) = if i &gt; #nTx cfg then empty else 1`(ipMkReq(cfg,i)) ++ ipReqMS(cfg,i+1);
fun ipReqArchiveMS(cfg:IP_RUNCFG,i:int) = if i &gt; #nTx cfg then empty else 1`(ipMkReq(cfg,i)) ++ ipReqArchiveMS(cfg,i+1);
fun ipGenRequests(cfg:IP_RUNCFG) = ipReqMS(cfg,1);
fun ipGenRequestArchive(cfg:IP_RUNCFG) = ipReqArchiveMS(cfg,1);

fun ipOwner(cfg:IP_RUNCFG,vid:int) =
 if #scenarioId cfg=5 andalso vid&lt;=3 then 1 else if vid=1 orelse vid=2 then 1 else vid;
fun ipStake(cfg:IP_RUNCFG,vid:int) =
 if #scenarioId cfg=5 then (if vid&lt;=3 then 2500+vid*400 else 60+vid*17)
 else if vid=3 then 900 else 100+ipPosMod(vid*83+ #baseSeed cfg,550);
fun ipMalicious(cfg:IP_RUNCFG,vid:int) = #scenarioId cfg=6 andalso (vid=3 orelse vid=7);
fun ipOffline(cfg:IP_RUNCFG,vid:int) = #scenarioId cfg=6 andalso (vid=4 orelse vid=8);
fun ipMkValidator(cfg:IP_RUNCFG,vid:int) : IP_VALIDATOR =
 {runId= #runId cfg,scenarioId= #scenarioId cfg,vid=vid,owner=ipOwner(cfg,vid),stake=ipStake(cfg,vid),
  battery=(if ipOffline(cfg,vid) then 15 else 55+ipPosMod(vid*11,40)),
  cpu=(if ipOffline(cfg,vid) then 18 else 50+ipPosMod(vid*7,45)),
  bandwidth=(if ipOffline(cfg,vid) then 10 else 50+ipPosMod(vid*19,50)),
  latency=(if ipOffline(cfg,vid) then 90 else 10+ipPosMod(vid*13,35)),
  availability=(if ipOffline(cfg,vid) then 20 else 75+ipPosMod(vid*9,25)),
  risk=(if ipMalicious(cfg,vid) then 90 else 5+ipPosMod(vid*7,28)),
  malicious=ipMalicious(cfg,vid),offline=ipOffline(cfg,vid)};
fun ipValList(cfg:IP_RUNCFG,i:int) = if i &gt; #nValidators cfg then [] else ipMkValidator(cfg,i)::ipValList(cfg,i+1);
fun ipValMS(cfg:IP_RUNCFG,i:int) = if i &gt; #nValidators cfg then empty else 1`(ipMkValidator(cfg,i)) ++ ipValMS(cfg,i+1);
fun ipGenValidators(cfg:IP_RUNCFG) = ipValMS(cfg,1);
fun ipValidatorList(cfg:IP_RUNCFG) = ipValList(cfg,1);

fun ipBalances(validators:IP_VALLIST) : IP_BALANCELIST =
  case validators of
      [] =&gt; []
    | (validator:IP_VALIDATOR)::remaining =&gt;
        {vid= #vid validator,owner= #owner validator,stake= #stake validator,reward=0,penalty=0}
        :: ipBalances(remaining);
fun ipInitialGov(cfg:IP_RUNCFG) : IP_GOVSTATE =
 {scores=[],balances=ipBalances(ipValidatorList(cfg)),quarantined=[],slashed=[],committeesBuilt=false};

fun ipInitialShard(cfg:IP_RUNCFG,sid:int) : IP_SHARDINFO =
 {sid=sid,load=(if #scenarioId cfg=7 andalso sid=1 then 48 else 10+sid*4),queue=0,
  latency=(if #scenarioId cfg=4 then 8+sid else 2+sid),capacity=(if sid=1 then 100 else 90),processed=0};
fun ipShardList(cfg:IP_RUNCFG,sid:int) = if sid &gt; #nShards cfg then [] else ipInitialShard(cfg,sid)::ipShardList(cfg,sid+1);
fun ipMapList(cfg:IP_RUNCFG,cid:int) = if cid&gt;16 then [] else
  {contractId=cid,sid=(if #scenarioId cfg=7 andalso cid&lt;=10 then 1 else 1+ipPosMod(cid-1,#nShards cfg))}::ipMapList(cfg,cid+1);
fun ipInitialRouteState(cfg:IP_RUNCFG) : IP_ROUTESTATE = {shards=ipShardList(cfg,1),mapping=ipMapList(cfg,1),version=1};

fun ipScenarioEvidence(cfg:IP_RUNCFG) =
  1`{runId= #runId cfg,scenarioId= #scenarioId cfg,txId=0,category=&quot;CONFIG&quot;,code=ipScenarioName(#scenarioId cfg),
     value= #nTx cfg,atTime=ipNow()};</layout>
        </ml>
        <ml id="ID995000642">(* ===== 03_R1_MobilePreparation ===== *)
(* ---------- R1 mobile request preparation ---------- *)
fun ipRequestAdmissible(r:IP_MREQ) = #signatureOK r andalso #walletOK r andalso #depositOK r andalso #edgeOK r
 andalso #battery r &gt;= 20 andalso #cpu r &gt;= 20 andalso #connectivity r &gt; 0;
fun ipEdgeDelay(r:IP_MREQ) = if #connectivity r=1 then 6 else 2;
fun ipPrepareTx(r:IP_MREQ) : IP_TX =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,contractId= #contractId r,targetContract= #targetContract r,
  userId= #userId r,amount= #amount r,battery= #battery r-1,cpu= #cpu r-2,connectivity= #connectivity r,
  createdAt= #createdAt r,preparedAt=ipNow()+ipEdgeDelay(r)};
fun ipOutcomeReq(r:IP_MREQ,code:string) : IP_OUTCOME =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,status=code,finalAt=ipNow(),evidenceId=ipHash3(#txId r,1,#scenarioId r)};
fun ipEvidenceReq(r:IP_MREQ,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R1_MOBILE_PREP&quot;,code=code,value=value,atTime=ipNow()};
          <layout>(* ===== 03_R1_MobilePreparation ===== *)
(* ---------- R1 mobile request preparation ---------- *)
fun ipRequestAdmissible(r:IP_MREQ) = #signatureOK r andalso #walletOK r andalso #depositOK r andalso #edgeOK r
 andalso #battery r &gt;= 20 andalso #cpu r &gt;= 20 andalso #connectivity r &gt; 0;
fun ipEdgeDelay(r:IP_MREQ) = if #connectivity r=1 then 6 else 2;
fun ipPrepareTx(r:IP_MREQ) : IP_TX =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,contractId= #contractId r,targetContract= #targetContract r,
  userId= #userId r,amount= #amount r,battery= #battery r-1,cpu= #cpu r-2,connectivity= #connectivity r,
  createdAt= #createdAt r,preparedAt=ipNow()+ipEdgeDelay(r)};
fun ipOutcomeReq(r:IP_MREQ,code:string) : IP_OUTCOME =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,status=code,finalAt=ipNow(),evidenceId=ipHash3(#txId r,1,#scenarioId r)};
fun ipEvidenceReq(r:IP_MREQ,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R1_MOBILE_PREP&quot;,code=code,value=value,atTime=ipNow()};</layout>
        </ml>
        <ml id="ID995000643">(* ===== 04_R2_Routing_Reconfiguration ===== *)
(* ---------- R2 adaptive routing and atomic reconfiguration ---------- *)
fun ipLookupMap(mapping:IP_MAPLIST,contractId:int) : int =
  case mapping of
      [] =&gt; 1
    | (entry:IP_MAPENTRY)::remaining =&gt;
        if #contractId entry = contractId then #sid entry
        else ipLookupMap(remaining,contractId);
fun ipFindShard(shards:IP_SHARDLIST,shardId:int) : IP_SHARDINFO =
  case shards of
      [] =&gt; {sid=shardId,load=100,queue=100,latency=100,capacity=1,processed=0}
    | (shard:IP_SHARDINFO)::remaining =&gt;
        if #sid shard = shardId then shard
        else ipFindShard(remaining,shardId);
fun ipRouteCost(tx:IP_TX,rs:IP_ROUTESTATE,sid:int) =
 let val sh=ipFindShard(#shards rs,sid)
     val home=ipLookupMap(#mapping rs,#contractId tx)
     val target=ipLookupMap(#mapping rs,#targetContract tx)
     val cross=if sid&lt;&gt;home orelse target&lt;&gt;home then 18 else 0
     val mobile=if #connectivity tx=1 then 8 else 0
 in #load sh + #queue sh*3 + #latency sh*2 + cross + mobile end;
fun ipBestShardFrom(tx:IP_TX,rs:IP_ROUTESTATE,sid:int,n:int,best:int,bestCost:int) =
 if sid&gt;n then best else
 let val c=ipRouteCost(tx,rs,sid)
 in if c&lt;bestCost then ipBestShardFrom(tx,rs,sid+1,n,sid,c)
    else ipBestShardFrom(tx,rs,sid+1,n,best,bestCost) end;
fun ipBestShard(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 ipBestShardFrom(tx,rs,2,#nShards cfg,1,ipRouteCost(tx,rs,1));
fun ipTargetShard(tx:IP_TX,rs:IP_ROUTESTATE) = ipLookupMap(#mapping rs,#targetContract tx);
fun ipIsCross(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 let val sid=ipBestShard(cfg,tx,rs) val home=ipLookupMap(#mapping rs,#contractId tx) val tgt=ipTargetShard(tx,rs)
 in sid&lt;&gt;home orelse tgt&lt;&gt;home end;
fun ipRouteDelay(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 1 + (ipRouteCost(tx,rs,ipBestShard(cfg,tx,rs)) div 20) + (if ipIsCross(cfg,tx,rs) then 3 else 0);
fun ipRouteTx(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) : IP_RTX =
 let val sid=ipBestShard(cfg,tx,rs) val d=ipRouteDelay(cfg,tx,rs)
 in {runId= #runId tx,scenarioId= #scenarioId tx,txId= #txId tx,contractId= #contractId tx,
  targetContract= #targetContract tx,userId= #userId tx,amount= #amount tx,battery= #battery tx,cpu= #cpu tx,
  connectivity= #connectivity tx,createdAt= #createdAt tx,preparedAt= #preparedAt tx,routeShard=sid,
  targetShard=ipTargetShard(tx,rs),crossShard=ipIsCross(cfg,tx,rs),routedAt=ipNow()+d} end;
fun ipUpdateShardRoute(shards:IP_SHARDLIST,shardId:int) : IP_SHARDLIST =
  case shards of
      [] =&gt; []
    | (shard:IP_SHARDINFO)::remaining =&gt;
        if #sid shard = shardId then
          {sid= #sid shard,load=ipMin(100,#load shard+8),queue= #queue shard+1,
           latency= #latency shard,capacity= #capacity shard,processed= #processed shard}::remaining
        else shard::ipUpdateShardRoute(remaining,shardId);
fun ipRouteStateAfter(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) : IP_ROUTESTATE =
 {shards=ipUpdateShardRoute(#shards rs,ipBestShard(cfg,tx,rs)),mapping= #mapping rs,version= #version rs};
fun ipHotAfter(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 let val rs2=ipRouteStateAfter(cfg,tx,rs) val sid=ipBestShard(cfg,tx,rs) val sh=ipFindShard(#shards rs2,sid)
 in #load sh &gt; #loadThreshold cfg end;
fun ipReconfigMS(cfg:IP_RUNCFG,tx:IP_TX,rs:IP_ROUTESTATE) =
 if ipHotAfter(cfg,tx,rs) then
  let val sid=ipBestShard(cfg,tx,rs)
  in 1`{runId= #runId tx,scenarioId= #scenarioId tx,txId= #txId tx,hotShard=sid,oldVersion= #version rs,
         newVersion= #version rs+1,reconfigAction=&quot;INCREASE_CAPACITY_AND_REMAP&quot;,atTime=ipNow()} end
 else empty;
fun ipReplaceShard(shards:IP_SHARDLIST,shardId:int) : IP_SHARDLIST =
  case shards of
      [] =&gt; []
    | (shard:IP_SHARDINFO)::remaining =&gt;
        if #sid shard = shardId then
          {sid= #sid shard,load=ipMax(0,#load shard-20),queue= #queue shard,
           latency=ipMax(1,#latency shard-1),capacity= #capacity shard+20,
           processed= #processed shard}::remaining
        else shard::ipReplaceShard(remaining,shardId);
fun ipRemapHot(mapping:IP_MAPLIST,hotShard:int,nShards:int) : IP_MAPLIST =
  case mapping of
      [] =&gt; []
    | (entry:IP_MAPENTRY)::remaining =&gt;
        (if #sid entry = hotShard andalso ipPosMod(#contractId entry,3)=0 then
           {contractId= #contractId entry,sid=1+ipPosMod(hotShard,nShards)}
         else entry)
        :: ipRemapHot(remaining,hotShard,nShards);
fun ipApplyReconfig(cfg:IP_RUNCFG,rs:IP_ROUTESTATE,r:IP_RECONFIG) : IP_ROUTESTATE =
 {shards=ipReplaceShard(#shards rs,#hotShard r),mapping=ipRemapHot(#mapping rs,#hotShard r,#nShards cfg),version= #version rs+1};
fun ipEvidenceRoute(r:IP_RTX,code:string,value:int) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R2_ROUTING&quot;,code=code,value=value,atTime=ipNow()};
fun ipEvidenceReconfig(r:IP_RECONFIG) : IP_EVIDENCE =
 {runId= #runId r,scenarioId= #scenarioId r,txId= #txId r,category=&quot;R10_RECONFIG&quot;,code= #reconfigAction r,value= #hotShard r,atTime=ipNow()};
